{% comment %}
  PLASTBAT — Capybara Zen Garden Product Main
  File: sections/plastbat-capybara-product-main.liquid

  Built for the personalized Capybara Halloween Zen Garden product.
  Key behavior:
  - Etsy-style stacked dropdown selectors (Tray color / Type Of Tray).
  - If the Shopify product has variant options, dropdowns are connected to real variants.
  - If the product has only the Default Title variant, editable fallback dropdown values
    are saved as Shopify line-item properties instead.
  - Optional collapsible personalization field with 25-character counter.
  - Sticky left gallery on desktop, releasing at the end of the product section.
  - Warm cream / brown Plastbat palette, large readable typography and editable accordions.

  INSTALL:
  1) Shopify Admin → Online Store → Themes → ... → Edit code
  2) Sections → Add a new section → plastbat-capybara-product-main
  3) Paste this entire file and Save.
  4) Customize the Capybara product template → add “Plastbat — Capybara Product”.
  5) Hide/remove the old Main product section on that template.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'pb-product-form-' | append: section.id
  assign rating_object = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign fallback_tray_colors = section.settings.manual_tray_colors | split: ','
  assign fallback_tray_types = section.settings.manual_tray_types | split: ','
  # Default choices mirror this Capybara listing: 20 tray colors + 4 tray types.
%}

<section
  id="PBProductMain-{{ section.id }}"
  class="pb-product-main color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="
    --pb-radius: {{ section.settings.corner_radius }}px;
    --pb-soft: {{ section.settings.soft_background }};
    --pb-border: {{ section.settings.border_color }};
    --pb-accent-custom: {{ section.settings.accent_color }};
  "
>
  <div class="page-width pb-product-main__inner">
    <div class="pb-product-main__grid">
      <!-- MEDIA -->
      <div class="pb-gallery{% unless section.settings.sticky_gallery == false %} pb-gallery--sticky{% endunless %}" data-pb-gallery>
        <div class="pb-gallery__stage">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              {% assign media_alt = media.alt | default: product.title %}
              <div
                class="pb-gallery__panel{% if forloop.first %} is-active{% endif %}"
                data-pb-media="{{ forloop.index0 }}"
                {% unless forloop.first %}hidden{% endunless %}
              >
                {% case media.media_type %}
                  {% when 'image' %}
                    {{
                      media.preview_image
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'eager',
                        widths: '480, 720, 960, 1200, 1600',
                        sizes: '(min-width: 990px) 56vw, 100vw',
                        class: 'pb-gallery__image',
                        alt: media_alt
                    }}
                  {% when 'video' %}
                    {{ media | video_tag: controls: true, image_size: '1200x', class: 'pb-gallery__video' }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag: class: 'pb-gallery__video' }}
                  {% when 'model' %}
                    {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, class: 'pb-gallery__model' }}
                  {% else %}
                    {{
                      media.preview_image
                      | image_url: width: 1600
                      | image_tag: class: 'pb-gallery__image', alt: media_alt
                    }}
                {% endcase %}
              </div>
            {% endfor %}

            {% if product.media.size > 1 %}
              <button class="pb-gallery__arrow pb-gallery__arrow--prev" type="button" data-pb-prev aria-label="Previous image">
                <span aria-hidden="true">‹</span>
              </button>
              <button class="pb-gallery__arrow pb-gallery__arrow--next" type="button" data-pb-next aria-label="Next image">
                <span aria-hidden="true">›</span>
              </button>
              <div class="pb-gallery__counter" aria-live="polite">
                <span data-pb-current>1</span> / {{ product.media.size }}
              </div>
            {% endif %}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'pb-gallery__placeholder' }}
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="pb-gallery__thumbs" role="list" aria-label="Product media">
            {% for media in product.media %}
              {% assign thumb_alt = media.alt | default: product.title %}
              <button
                type="button"
                class="pb-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-pb-thumb="{{ forloop.index0 }}"
                aria-label="View media {{ forloop.index }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {{
                  media.preview_image
                  | image_url: width: 220
                  | image_tag: loading: 'lazy', class: 'pb-gallery__thumb-image', alt: thumb_alt
                }}
                {% if media.media_type != 'image' %}
                  <span class="pb-gallery__media-icon" aria-hidden="true">▶</span>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- PRODUCT INFO -->
      <div class="pb-info">
        {% if section.settings.eyebrow != blank %}
          <div class="pb-eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {% endif %}

        <h1 class="pb-title">{{ product.title }}</h1>

        <div class="pb-meta-row">
          {% if rating_object != blank %}
            <a class="pb-rating" href="#pb-reviews-{{ section.id }}" aria-label="Product reviews">
              <span class="pb-rating__stars" aria-hidden="true">★★★★★</span>
              <span>
                {{ rating_object.rating | round: 1 }}{% if rating_count != blank %} ({{ rating_count }}){% endif %}
              </span>
            </a>
          {% elsif section.settings.fallback_social_proof != blank %}
            <span class="pb-social-proof">{{ section.settings.fallback_social_proof | escape }}</span>
          {% endif %}

          {% if current_variant.available %}
            <span class="pb-stock pb-stock--in"><i></i>{{ section.settings.in_stock_text | escape }}</span>
          {% else %}
            <span class="pb-stock pb-stock--out"><i></i>{{ section.settings.sold_out_text | escape }}</span>
          {% endif %}
        </div>

        <div class="pb-price-wrap" aria-live="polite">
          <span class="pb-price" data-pb-price>{{ current_variant.price | money }}</span>
          <span
            class="pb-compare-price{% unless current_variant.compare_at_price > current_variant.price %} is-hidden{% endunless %}"
            data-pb-compare
          >
            {% if current_variant.compare_at_price > current_variant.price %}
              {{ current_variant.compare_at_price | money }}
            {% endif %}
          </span>
          {% if current_variant.compare_at_price > current_variant.price %}
            {% assign initial_save = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price %}
          {% else %}
            {% assign initial_save = 0 %}
          {% endif %}
          <span class="pb-sale-badge{% if initial_save == 0 %} is-hidden{% endif %}" data-pb-sale>
            Save {{ initial_save }}%
          </span>
        </div>

        {% if section.settings.short_benefit != blank %}
          <p class="pb-short-benefit">{{ section.settings.short_benefit | escape }}</p>
        {% endif %}

        {% form 'product', product, id: product_form_id, class: 'pb-product-form' %}
          <!-- CAPYBARA PRODUCT OPTIONS: TRAY COLOR + TYPE OF TRAY -->
          <div class="pb-etsy-options" data-pb-options>
            <!-- Tray color is a line-item property. It does NOT control price. -->
            <div class="pb-etsy-choice">
              <label class="pb-label pb-etsy-label" for="PBTrayColor-{{ section.id }}">{{ section.settings.option_1_label | escape }}</label>
              <div class="pb-select-wrap">
                <select
                  class="pb-select pb-etsy-select"
                  id="PBTrayColor-{{ section.id }}"
                  name="properties[Tray color]"
                  data-pb-tray-color
                  required
                >
                  <option value="" selected disabled>{{ section.settings.option_placeholder | escape }}</option>
                  {% for raw_value in fallback_tray_colors %}
                    {% assign clean_value = raw_value | strip %}
                    {% if clean_value != blank %}
                      <option value="{{ clean_value | escape }}">{{ clean_value }}</option>
                    {% endif %}
                  {% endfor %}
                </select>
              </div>
            </div>

            <!-- Type Of Tray is the Shopify variant. Its variant price updates live. -->
            <div class="pb-etsy-choice">
              <label class="pb-label pb-etsy-label" for="PBTrayType-{{ section.id }}">{{ section.settings.option_2_label | escape }}</label>
              <div class="pb-select-wrap">
                {% unless product.has_only_default_variant %}
                  <select
                    class="pb-select pb-etsy-select"
                    id="PBTrayType-{{ section.id }}"
                    name="id"
                    data-pb-tray-type-select
                    required
                  >
                    <option value="" selected disabled>{{ section.settings.option_placeholder | escape }}</option>
                    {% for variant in product.variants %}
                      {% if variant.compare_at_price > variant.price %}
                        {% assign variant_save = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price %}
                      {% else %}
                        {% assign variant_save = 0 %}
                      {% endif %}
                      <option
                        value="{{ variant.id }}"
                        data-price="{{ variant.price | money | escape }}"
                        data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                        data-save="{{ variant_save }}"
                        data-available="{{ variant.available }}"
                      >{{ variant.title }}</option>
                    {% endfor %}
                  </select>
                {% else %}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  <select
                    class="pb-select pb-etsy-select"
                    id="PBTrayType-{{ section.id }}"
                    name="properties[Type Of Tray]"
                    data-pb-manual-type
                    required
                  >
                    <option value="" selected disabled>{{ section.settings.option_placeholder | escape }}</option>
                    {% for raw_value in fallback_tray_types %}
                      {% assign clean_value = raw_value | strip %}
                      {% if clean_value != blank %}
                        <option value="{{ clean_value | escape }}">{{ clean_value }}</option>
                      {% endif %}
                    {% endfor %}
                  </select>
                {% endunless %}
              </div>
            </div>
          </div>

          <!-- OPTIONAL PERSONALIZATION, ETSY-STYLE -->
          <div class="pb-personalization-etsy{% if section.settings.personalization_open %} is-open{% endif %}">
            <button
              class="pb-personalization-toggle"
              type="button"
              data-pb-personalization-toggle
              aria-expanded="{% if section.settings.personalization_open %}true{% else %}false{% endif %}"
              aria-controls="PBPersonalizationPanel-{{ section.id }}"
            >
              <span class="pb-personalization-toggle__symbol" data-pb-personalization-symbol>{% if section.settings.personalization_open %}−{% else %}+{% endif %}</span>
              <span>{{ section.settings.personalization_label | escape }} <em>{{ section.settings.personalization_optional_text | escape }}</em></span>
            </button>

            <div
              class="pb-personalization-panel"
              id="PBPersonalizationPanel-{{ section.id }}"
              data-pb-personalization-panel
              {% unless section.settings.personalization_open %}hidden{% endunless %}
            >
              {% if section.settings.personalization_prompt != blank %}
                <label class="pb-personalization-prompt" for="PBPersonalization-{{ section.id }}">{{ section.settings.personalization_prompt | escape }}</label>
              {% endif %}
              {% if section.settings.personalization_example != blank %}
                <p class="pb-personalization-example">{{ section.settings.personalization_example | escape }}</p>
              {% endif %}

              <div class="pb-textarea-shell">
                <textarea
                  class="pb-input pb-textarea"
                  id="PBPersonalization-{{ section.id }}"
                  name="properties[Personalization]"
                  maxlength="{{ section.settings.personalization_max_chars }}"
                  placeholder="{{ section.settings.personalization_placeholder | escape }}"
                  autocomplete="off"
                  {% if section.settings.personalization_required %}required{% endif %}
                  data-pb-personalization
                ></textarea>
                <span class="pb-char-count pb-char-count--textarea"><b data-pb-char-count>0</b>/{{ section.settings.personalization_max_chars }}</span>
              </div>
              {% if section.settings.personalization_help != blank %}
                <p class="pb-help">{{ section.settings.personalization_help | escape }}</p>
              {% endif %}
            </div>
          </div>

          <!-- QUANTITY + CTA -->
          <div class="pb-buy-row pb-buy-row--etsy">
            <div class="pb-qty" data-pb-qty>
              <button type="button" class="pb-qty__button" data-pb-minus aria-label="Decrease quantity">−</button>
              <input class="pb-qty__input" type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" aria-label="Quantity">
              <button type="button" class="pb-qty__button" data-pb-plus aria-label="Increase quantity">+</button>
            </div>

            <button
              type="submit"
              name="add"
              class="pb-atc"
              data-pb-atc
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span data-pb-atc-text>{% if current_variant.available %}{{ section.settings.add_to_cart_text | escape }}{% else %}{{ section.settings.sold_out_text | escape }}{% endif %}</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>

          {% if section.settings.checkout_note != blank %}
            <p class="pb-checkout-note">🔒 {{ section.settings.checkout_note | escape }}</p>
          {% endif %}
        {% endform %}

        <!-- TRUST -->
        <div class="pb-trust-grid">
          {% if section.settings.trust_1 != blank %}
            <div class="pb-trust-card">
              <span class="pb-trust-card__icon" aria-hidden="true">✦</span>
              <span>{{ section.settings.trust_1 | escape }}</span>
            </div>
          {% endif %}
          {% if section.settings.trust_2 != blank %}
            <div class="pb-trust-card">
              <span class="pb-trust-card__icon" aria-hidden="true">↗</span>
              <span>{{ section.settings.trust_2 | escape }}</span>
            </div>
          {% endif %}
          {% if section.settings.trust_3 != blank %}
            <div class="pb-trust-card">
              <span class="pb-trust-card__icon" aria-hidden="true">♡</span>
              <span>{{ section.settings.trust_3 | escape }}</span>
            </div>
          {% endif %}
        </div>

        <!-- ACCORDIONS -->
        <div class="pb-accordions">
          <details class="pb-accordion" {% if section.settings.open_description %}open{% endif %}>
            <summary>
              <span>{{ section.settings.description_heading | escape }}</span>
              <span class="pb-accordion__plus" aria-hidden="true"></span>
            </summary>
            <div class="pb-accordion__content rte">
              {% if section.settings.description_body != blank %}
                {{ section.settings.description_body }}
              {% else %}
                {{ product.description }}
              {% endif %}
            </div>
          </details>

          {% if section.settings.details_text != blank %}
            <details class="pb-accordion">
              <summary>
                <span>{{ section.settings.details_heading | escape }}</span>
                <span class="pb-accordion__plus" aria-hidden="true"></span>
              </summary>
              <div class="pb-accordion__content rte">{{ section.settings.details_text }}</div>
            </details>
          {% endif %}

          {% if section.settings.shipping_text != blank %}
            <details class="pb-accordion">
              <summary>
                <span>{{ section.settings.shipping_heading | escape }}</span>
                <span class="pb-accordion__plus" aria-hidden="true"></span>
              </summary>
              <div class="pb-accordion__content rte">{{ section.settings.shipping_text }}</div>
            </details>
          {% endif %}

          {% if section.settings.personalization_info != blank %}
            <details class="pb-accordion">
              <summary>
                <span>{{ section.settings.personalization_heading | escape }}</span>
                <span class="pb-accordion__plus" aria-hidden="true"></span>
              </summary>
              <div class="pb-accordion__content rte">{{ section.settings.personalization_info }}</div>
            </details>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- MOBILE STICKY CTA -->
  {% if section.settings.mobile_sticky_atc %}
    <div class="pb-mobile-bar" data-pb-mobile-bar>
      <div class="pb-mobile-bar__price" data-pb-mobile-price>{{ current_variant.price | money }}</div>
      <button
        type="submit"
        form="{{ product_form_id }}"
        class="pb-mobile-bar__button"
        data-pb-mobile-atc
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {% if current_variant.available %}{{ section.settings.add_to_cart_text | escape }}{% else %}{{ section.settings.sold_out_text | escape }}{% endif %}
      </button>
    </div>
  {% endif %}
</section>

<style>
  /*
    V2 visual system
    - The page background still comes from the active Shopify color scheme.
    - UI surfaces are intentionally warmer/cleaner so the section feels integrated
      with Plastbat's cream + brown storefront without looking flat.
  */
  #PBProductMain-{{ section.id }} {
    --pb-theme-accent: {% if section.settings.use_theme_colors %}rgb(var(--color-button, 190, 137, 83)){% else %}var(--pb-accent-custom){% endif %};
    --pb-accent: color-mix(in srgb, var(--pb-theme-accent) 72%, #c68a51 28%);
    --pb-cta: color-mix(in srgb, var(--pb-accent) 38%, #5c4436 62%);
    --pb-cta-hover: color-mix(in srgb, var(--pb-cta) 86%, #2f211a 14%);
    --pb-text: color-mix(in srgb, rgb(var(--color-foreground, 83, 65, 54)) 68%, #5a4437 32%);
    --pb-muted: #8f7e72;
    --pb-bg: rgb(var(--color-background, 250, 247, 242));
    --pb-panel: color-mix(in srgb, var(--pb-bg) 48%, #fffdf9 52%);
    --pb-soft-ui: color-mix(in srgb, var(--pb-soft) 46%, #f5eee5 54%);
    --pb-border-ui: color-mix(in srgb, var(--pb-border) 54%, #e3d5c7 46%);
    color: var(--pb-text);
    background: var(--pb-bg);
    font-family: var(--font-body-family, inherit);
    font-size: 16px;
    line-height: 1.5;
  }

  /* Sticky needs visible overflow on the section wrapper in themes that clip sections. */
  .shopify-section:has(#PBProductMain-{{ section.id }}) { overflow: visible !important; }

  #PBProductMain-{{ section.id }} * { box-sizing: border-box; }
  #PBProductMain-{{ section.id }} .is-hidden { display: none !important; }
  #PBProductMain-{{ section.id }} .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  #PBProductMain-{{ section.id }} .pb-product-main__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: min({{ section.settings.padding_bottom }}px, 36px);
  }

  #PBProductMain-{{ section.id }} .pb-product-main__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(420px, .97fr);
    gap: clamp(34px, 4.1vw, 62px);
    align-items: start;
  }

  /* ---------------- GALLERY ---------------- */
  #PBProductMain-{{ section.id }} .pb-gallery {
    min-width: 0;
    align-self: start;
  }

  #PBProductMain-{{ section.id }} .pb-gallery--sticky {
    position: sticky;
    top: {{ section.settings.sticky_top }}px;
    z-index: 2;
    height: max-content;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__stage {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--pb-radius) + 2px);
    background: var(--pb-panel);
    border: 1px solid var(--pb-border-ui);
    aspect-ratio: 1 / 1;
    box-shadow: 0 18px 44px rgba(82, 60, 45, .055);
  }

  #PBProductMain-{{ section.id }} .pb-gallery__panel {
    width: 100%;
    height: 100%;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__panel.is-active { display: block; }

  #PBProductMain-{{ section.id }} .pb-gallery__image,
  #PBProductMain-{{ section.id }} .pb-gallery__video,
  #PBProductMain-{{ section.id }} .pb-gallery__model,
  #PBProductMain-{{ section.id }} .pb-gallery__placeholder {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(76, 57, 45, .14);
    background: rgba(255, 253, 249, .94);
    color: #49362b;
    display: grid;
    place-items: center;
    cursor: pointer;
    z-index: 3;
    box-shadow: 0 7px 22px rgba(76, 57, 45, .10);
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__arrow:hover {
    transform: translateY(-50%) scale(1.045);
    background: #fff;
    box-shadow: 0 10px 28px rgba(76, 57, 45, .14);
  }

  #PBProductMain-{{ section.id }} .pb-gallery__arrow span {
    font-size: 30px;
    line-height: 1;
    margin-top: -2px;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__arrow--prev { left: 15px; }
  #PBProductMain-{{ section.id }} .pb-gallery__arrow--next { right: 15px; }

  #PBProductMain-{{ section.id }} .pb-gallery__counter {
    position: absolute;
    right: 14px;
    bottom: 14px;
    background: rgba(255, 253, 249, .94);
    border: 1px solid rgba(76, 57, 45, .11);
    color: #5d4638;
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    box-shadow: 0 4px 14px rgba(76, 57, 45, .07);
  }

  #PBProductMain-{{ section.id }} .pb-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    margin-top: 13px;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__thumb {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: max(9px, calc(var(--pb-radius) * .55));
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--pb-border-ui);
    background: var(--pb-panel);
    cursor: pointer;
    opacity: .72;
    transition: opacity .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__thumb:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  #PBProductMain-{{ section.id }} .pb-gallery__thumb.is-active {
    opacity: 1;
    border-color: var(--pb-accent);
    box-shadow: inset 0 0 0 1px var(--pb-accent), 0 5px 14px rgba(100, 72, 48, .08);
  }

  #PBProductMain-{{ section.id }} .pb-gallery__thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__media-icon {
    position: absolute;
    right: 5px;
    bottom: 5px;
    background: rgba(76, 57, 45, .78);
    color: white;
    width: 21px;
    height: 21px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-size: 8px;
  }

  /* ---------------- PRODUCT INFO ---------------- */
  #PBProductMain-{{ section.id }} .pb-info {
    min-width: 0;
    font-size: 16px;
  }

  #PBProductMain-{{ section.id }} .pb-eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 31px;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--pb-panel);
    border: 1px solid var(--pb-border-ui);
    color: #6f5849;
    font-size: 11.5px;
    line-height: 1;
    letter-spacing: .105em;
    text-transform: uppercase;
    font-weight: 800;
    margin-bottom: 15px;
  }

  #PBProductMain-{{ section.id }} .pb-title {
    margin: 0;
    max-width: 18ch;
    color: #5b4437;
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(36px, 3.05vw, 48px);
