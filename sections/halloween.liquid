{% comment %}
  PLASTBAT UNIVERSAL OPTIONS V5 — RELATED FIX
  File: sections/plastbat-universal-options-v5-related-fix.liquid

  Recognized Shopify product option names:
  - Chair Color / Choose Chair Color  -> color swatches, label "Choose Chair Color"
  - Size / Choose Size                -> dropdown, label "Choose Size"
  - Color / Colour                    -> color swatches, label "Color"
  - Number of Slots / Slots           -> dropdown, label "Choose Number of Slots"
  - Bow Color / Bow Colour            -> color swatches, label "Choose Bow Color"
  - Any other Shopify option          -> normal dropdown using its own name

  ADD PERSONALIZATION:
  Enabled per product by either:
  - Product metafield custom.enable_personalization = true
  OR
  - product tag: pp-personalization

  Product metafields for personalization (optional):
  custom.personalization_required
  custom.personalization_label
  custom.personalization_placeholder
  custom.personalization_max_chars

  PRICE:
  Prices are NEVER hard-coded here.
  Variant choices/prices/stock come from the Shopify product listing.
  Any selection that changes price must be a Shopify variant option.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'PUV2Form-' | append: section.id

  assign show_chair_color = section.settings.show_chair_color
  assign show_size = section.settings.show_size
  assign show_color = section.settings.show_color
  assign show_slots = section.settings.show_slots
  assign show_bow_color = section.settings.show_bow_color
  assign show_other_options = section.settings.show_other_options


  assign show_personalization = section.settings.personalization_default
  if product.tags contains 'pp-personalization'
    assign show_personalization = true
  endif
  if product.metafields.custom.enable_personalization != blank
    assign show_personalization = product.metafields.custom.enable_personalization.value
  endif

  assign personalization_required = false
  if product.metafields.custom.personalization_required != blank
    assign personalization_required = product.metafields.custom.personalization_required.value
  endif

  assign personalization_label = section.settings.personalization_label
  if product.metafields.custom.personalization_label != blank
    assign personalization_label = product.metafields.custom.personalization_label.value
  endif

  assign personalization_placeholder = section.settings.personalization_placeholder
  if product.metafields.custom.personalization_placeholder != blank
    assign personalization_placeholder = product.metafields.custom.personalization_placeholder.value
  endif

  assign personalization_max = section.settings.personalization_max
  if product.metafields.custom.personalization_max_chars != blank
    assign personalization_max = product.metafields.custom.personalization_max_chars.value
  endif

  if current_variant.compare_at_price > current_variant.price
    assign initial_save = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  else
    assign initial_save = 0
  endif
%}

<section
  id="PUV2-{{ section.id }}"
  class="puv2 color-{{ section.settings.color_scheme }}"
  style="
    --puv2-accent-custom: {{ section.settings.accent_color }};
    --puv2-soft-custom: {{ section.settings.soft_background }};
    --puv2-border-custom: {{ section.settings.border_color }};
    --puv2-radius: {{ section.settings.corner_radius }}px;
  "
>
  <div class="page-width puv2__wrap">
    <div class="puv2__grid">

      <!-- LEFT GALLERY -->
      <div class="puv2-gallery{% if section.settings.sticky_gallery %} puv2-gallery--sticky{% endif %}">
        <div class="puv2-gallery__stage">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <div
                class="puv2-gallery__panel{% if forloop.first %} is-active{% endif %}"
                data-puv2-media-index="{{ forloop.index0 }}"
                data-puv2-media-id="{{ media.id }}"
                {% unless forloop.first %}hidden{% endunless %}
              >
                {% case media.media_type %}
                  {% when 'image' %}
                    {{
                      media.preview_image
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'eager',
                        widths: '480,720,960,1200,1600',
                        sizes: '(min-width: 990px) 54vw, 100vw',
                        class: 'puv2-gallery__image',
                        alt: media.alt | default: product.title
                    }}
                  {% when 'video' %}
                    {{ media | video_tag: controls: true, image_size: '1200x', class: 'puv2-gallery__media' }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag: class: 'puv2-gallery__media' }}
                  {% when 'model' %}
                    {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, class: 'puv2-gallery__media' }}
                  {% else %}
                    {{
                      media.preview_image
                      | image_url: width: 1600
                      | image_tag: class: 'puv2-gallery__image', alt: media.alt | default: product.title
                    }}
                {% endcase %}
              </div>
            {% endfor %}

            {% if product.media.size > 1 %}
              <button class="puv2-gallery__arrow puv2-gallery__arrow--prev" type="button" data-puv2-prev aria-label="Previous image">‹</button>
              <button class="puv2-gallery__arrow puv2-gallery__arrow--next" type="button" data-puv2-next aria-label="Next image">›</button>
              <span class="puv2-gallery__counter"><b data-puv2-current>1</b> / {{ product.media.size }}</span>
            {% endif %}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'puv2-gallery__placeholder' }}
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="puv2-gallery__thumbs">
            {% for media in product.media %}
              <button
                type="button"
                class="puv2-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-puv2-thumb="{{ forloop.index0 }}"
                aria-label="View image {{ forloop.index }}"
              >
                {{
                  media.preview_image
                  | image_url: width: 220
                  | image_tag:
                    loading: 'lazy',
                    class: 'puv2-gallery__thumb-image',
                    alt: media.alt | default: product.title
                }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- RIGHT INFO -->
      <div class="puv2-info">
        {% if section.settings.eyebrow != blank %}
          <div class="puv2-eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {% endif %}

        <h1 class="puv2-title">{{ product.title }}</h1>

        <div class="puv2-status">
          <span class="puv2-stock{% unless current_variant.available %} is-out{% endunless %}" data-puv2-stock>
            <i></i>
            <span data-puv2-stock-text>
              {% if current_variant.available %}
                {{ section.settings.in_stock_text | escape }}
              {% else %}
                {{ section.settings.sold_out_text | escape }}
              {% endif %}
            </span>
          </span>
        </div>

        <div class="puv2-price-row" aria-live="polite">
          <span class="puv2-price" data-puv2-price>{{ current_variant.price | money }}</span>

          <span
            class="puv2-compare{% unless current_variant.compare_at_price > current_variant.price %} is-hidden{% endunless %}"
            data-puv2-compare
          >
            {% if current_variant.compare_at_price > current_variant.price %}
              {{ current_variant.compare_at_price | money }}
            {% endif %}
          </span>

          <span
            class="puv2-sale{% if initial_save == 0 %} is-hidden{% endif %}"
            data-puv2-sale
          >
            SAVE {{ initial_save }}%
          </span>
        </div>

        {% if section.settings.short_benefit != blank %}
          <p class="puv2-benefit">{{ section.settings.short_benefit | escape }}</p>
        {% endif %}

        {% form 'product', product, id: product_form_id, class: 'puv2-form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-puv2-variant-id>

          <!-- UNIVERSAL SHOPIFY LISTING OPTIONS WITH INDIVIDUAL ON/OFF CONTROLS -->
          {% unless product.has_only_default_variant %}
            <div class="puv2-options">
              {% for option in product.options_with_values %}
                {% assign option_down = option.name | downcase | strip %}
                {% assign option_label = option.name %}
                {% assign option_kind = 'dropdown' %}
                {% assign option_enabled = show_other_options %}

                {% if option_down contains 'chair' and option_down contains 'color' %}
                  {% assign option_label = section.settings.chair_color_label %}
                  {% assign option_kind = 'swatch' %}
                  {% assign option_enabled = show_chair_color %}
                {% elsif option_down contains 'chair' and option_down contains 'colour' %}
                  {% assign option_label = section.settings.chair_color_label %}
                  {% assign option_kind = 'swatch' %}
                  {% assign option_enabled = show_chair_color %}
                {% elsif option_down == 'size' or option_down contains 'choose size' %}
                  {% assign option_label = section.settings.size_label %}
                  {% assign option_kind = 'dropdown' %}
                  {% assign option_enabled = show_size %}
                {% elsif option_down contains 'slot' %}
                  {% assign option_label = section.settings.slots_label %}
                  {% assign option_kind = 'dropdown' %}
                  {% assign option_enabled = show_slots %}
                {% elsif option_down contains 'bow' and option_down contains 'color' %}
                  {% assign option_label = section.settings.bow_color_label %}
                  {% assign option_kind = 'swatch' %}
                  {% assign option_enabled = show_bow_color %}
                {% elsif option_down contains 'bow' and option_down contains 'colour' %}
                  {% assign option_label = section.settings.bow_color_label %}
                  {% assign option_kind = 'swatch' %}
                  {% assign option_enabled = show_bow_color %}
                {% elsif option_down == 'color' or option_down == 'colour' or option_down contains 'choose color' or option_down contains 'choose colour' %}
                  {% assign option_label = section.settings.color_label %}
                  {% assign option_kind = 'swatch' %}
                  {% assign option_enabled = show_color %}
                {% endif %}

                {% if option_enabled %}
                  <fieldset
                    class="puv2-option"
                    data-puv2-option-index="{{ forloop.index0 }}"
                    data-puv2-option-name="{{ option.name | escape }}"
                  >
                    <legend class="puv2-label">{{ option_label | escape }}</legend>

                    {% if option_kind == 'swatch' %}
                      <div class="puv2-swatches">
                        {% for option_value in option.values %}
                          {% assign value_name = option_value | strip %}
                          {% assign value_handle = value_name | handleize %}
                          <label class="puv2-swatch">
                            <input
                              type="radio"
                              name="PUV2-{{ section.id }}-option-{{ option.position }}"
                              value="{{ option_value | escape }}"
                              data-puv2-option-value
                              {% if option_value.selected %}checked{% endif %}
                            >
                            <span
                              class="puv2-swatch__dot puv2-color--{{ value_handle }}"
                              {% if option_value.swatch.color != blank %}
                                style="background: {{ option_value.swatch.color }};"
                              {% endif %}
                            ></span>
                            <span class="puv2-swatch__name">{{ option_value }}</span>
                            <span class="puv2-swatch__check" aria-hidden="true">✓</span>
                          </label>
                        {% endfor %}
                      </div>
                    {% else %}
                      <div class="puv2-select-wrap">
                        <select
                          class="puv2-select"
                          data-puv2-option-select
                          data-puv2-option-position="{{ forloop.index0 }}"
                          aria-label="{{ option_label | escape }}"
                        >
                          {% for option_value in option.values %}
                            <option
                              value="{{ option_value | escape }}"
                              data-puv2-base-label="{{ option_value | escape }}"
                              {% if option_value.selected %}selected{% endif %}
                            >
                              {{ option_value }}{% if option_value.variant != blank %} ({{ option_value.variant.price | money }}){% endif %}
                            </option>
                          {% endfor %}
                        </select>
                        <span class="puv2-select-arrow" aria-hidden="true">⌄</span>
                      </div>
                    {% endif %}
                  </fieldset>
                {% endif %}
              {% endfor %}
            </div>
          {% endunless %}

          <!-- ADD PERSONALIZATION -->
          {% if show_personalization %}
            <div class="puv2-personalization">
              <div class="puv2-personalization__head">
                <label class="puv2-label" for="PUV2Personalization-{{ section.id }}">
                  {{ personalization_label | escape }}
                </label>
                <span class="puv2-badge">
                  {% if personalization_required %}
                    {{ section.settings.required_text | escape }}
                  {% else %}
                    {{ section.settings.optional_text | escape }}
                  {% endif %}
                </span>
              </div>

              <div class="puv2-personalization__input-wrap">
                <input
                  id="PUV2Personalization-{{ section.id }}"
                  class="puv2-personalization__input"
                  type="text"
                  name="properties[{{ personalization_label | escape }}]"
                  maxlength="{{ personalization_max }}"
                  placeholder="{{ personalization_placeholder | escape }}"
                  data-puv2-personalization
                  {% if personalization_required %}required{% endif %}
                >
                <span class="puv2-char-count">
                  <span data-puv2-char-count>0</span>/{{ personalization_max }}
                </span>
              </div>

              {% if section.settings.personalization_help != blank %}
                <p class="puv2-help">{{ section.settings.personalization_help | escape }}</p>
              {% endif %}
            </div>
          {% endif %}

          <div class="puv2-buy">
            <div class="puv2-qty">
              <button type="button" data-puv2-minus aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" max="99" data-puv2-qty aria-label="Quantity">
              <button type="button" data-puv2-plus aria-label="Increase quantity">+</button>
            </div>

            <button
              class="puv2-atc"
              type="submit"
              name="add"
              data-puv2-atc
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span data-puv2-atc-text>
                {% if current_variant.available %}
                  {{ section.settings.add_to_cart_text | escape }}
                {% else %}
                  {{ section.settings.sold_out_text | escape }}
                {% endif %}
              </span>
              <span aria-hidden="true">→</span>
            </button>
          </div>

          {% if section.settings.checkout_note != blank %}
            <p class="puv2-checkout-note">🔒 {{ section.settings.checkout_note | escape }}</p>
          {% endif %}
        {% endform %}

        {% if section.settings.show_trust %}
          <div class="puv2-trust">
            <div><span>✦</span><strong>{{ section.settings.trust_1 | escape }}</strong></div>
            <div><span>↗</span><strong>{{ section.settings.trust_2 | escape }}</strong></div>
            <div><span>♡</span><strong>{{ section.settings.trust_3 | escape }}</strong></div>
          </div>
        {% endif %}

        <div class="puv2-accordions">
          <details class="puv2-accordion" {% if section.settings.open_description %}open{% endif %}>
            <summary>
              <span>{{ section.settings.description_heading | escape }}</span>
              <span class="puv2-plus" aria-hidden="true"></span>
            </summary>
            <div class="puv2-accordion__content rte">
              {% if section.settings.description_body != blank %}
                {{ section.settings.description_body }}
              {% else %}
                {{ product.description }}
              {% endif %}
            </div>
          </details>

          {% if section.settings.details_text != blank %}
            <details class="puv2-accordion">
              <summary>
                <span>{{ section.settings.details_heading | escape }}</span>
                <span class="puv2-plus" aria-hidden="true"></span>
              </summary>
              <div class="puv2-accordion__content rte">{{ section.settings.details_text }}</div>
            </details>
          {% endif %}

          {% if section.settings.shipping_text != blank %}
            <details class="puv2-accordion">
              <summary>
                <span>{{ section.settings.shipping_heading | escape }}</span>
                <span class="puv2-plus" aria-hidden="true"></span>
              </summary>
              <div class="puv2-accordion__content rte">{{ section.settings.shipping_text }}</div>
            </details>
          {% endif %}

          {% if section.settings.personalization_info != blank %}
            <details class="puv2-accordion">
              <summary>
                <span>{{ section.settings.personalization_info_heading | escape }}</span>
                <span class="puv2-plus" aria-hidden="true"></span>
              </summary>
              <div class="puv2-accordion__content rte">{{ section.settings.personalization_info }}</div>
            </details>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .shopify-section:has(#PUV2-{{ section.id }}) { overflow: visible !important; }

  #PUV2-{{ section.id }} {
    --puv2-theme:
      {% if section.settings.use_theme_colors %}
        rgb(var(--color-button, 118, 88, 69))
      {% else %}
        var(--puv2-accent-custom)
      {% endif %};
    --puv2-dark: color-mix(in srgb, var(--puv2-theme) 68%, #34271f 32%);
    --puv2-accent: color-mix(in srgb, var(--puv2-theme) 70%, #bd8a63 30%);
    --puv2-text: color-mix(in srgb, rgb(var(--color-foreground, 78,59,48)) 78%, #513e33 22%);
    --puv2-muted: #8e7e73;
    --puv2-bg: rgb(var(--color-background, 250,247,242));
    --puv2-soft: color-mix(in srgb, var(--puv2-soft-custom) 56%, #fff 44%);
    --puv2-border: color-mix(in srgb, var(--puv2-border-custom) 72%, #e7ddd5 28%);

    color: var(--puv2-text);
    background: var(--puv2-bg);
    font-family: var(--font-body-family, inherit);
    line-height: 1.5;
  }

  #PUV2-{{ section.id }} * { box-sizing: border-box; }
  #PUV2-{{ section.id }} .is-hidden { display: none !important; }

  #PUV2-{{ section.id }} .puv2__wrap {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #PUV2-{{ section.id }} .puv2__grid {
    display: grid;
    grid-template-columns: minmax(0,1.04fr) minmax(420px,.96fr);
    gap: clamp(34px,4.2vw,66px);
    align-items: start;
  }

  #PUV2-{{ section.id }} .puv2-gallery { min-width:0; align-self:start; }

  #PUV2-{{ section.id }} .puv2-gallery--sticky {
    position: sticky;
    top: {{ section.settings.sticky_top }}px;
    height: max-content;
    z-index: 2;
  }

  #PUV2-{{ section.id }} .puv2-gallery__stage {
    position:relative;
    aspect-ratio:1/1;
    overflow:hidden;
    border:1px solid var(--puv2-border);
    border-radius:calc(var(--puv2-radius) + 2px);
    background:var(--puv2-soft);
    box-shadow:0 18px 48px rgba(65,47,35,.06);
  }

  #PUV2-{{ section.id }} .puv2-gallery__panel { width:100%; height:100%; }

  #PUV2-{{ section.id }} .puv2-gallery__image,
  #PUV2-{{ section.id }} .puv2-gallery__media,
  #PUV2-{{ section.id }} .puv2-gallery__placeholder {
    width:100%;
    height:100%;
    display:block;
    object-fit:contain;
  }

  #PUV2-{{ section.id }} .puv2-gallery__arrow {
    position:absolute;
    top:50%;
    z-index:4;
    width:46px;
    height:46px;
    transform:translateY(-50%);
    display:grid;
    place-items:center;
    border:1px solid rgba(75,55,43,.13);
    border-radius:999px;
    background:rgba(255,255,255,.95);
    color:#4b392e;
    font-size:30px;
    cursor:pointer;
    box-shadow:0 8px 24px rgba(58,42,32,.12);
  }

  #PUV2-{{ section.id }} .puv2-gallery__arrow--prev { left:15px; }
  #PUV2-{{ section.id }} .puv2-gallery__arrow--next { right:15px; }

  #PUV2-{{ section.id }} .puv2-gallery__counter {
    position:absolute;
    right:14px;
    bottom:14px;
    z-index:4;
    padding:7px 11px;
    border:1px solid rgba(85,65,53,.12);
    border-radius:999px;
    background:rgba(255,255,255,.94);
    color:#594539;
    font-size:13px;
  }

  #PUV2-{{ section.id }} .puv2-gallery__thumbs {
    display:grid;
    grid-template-columns:repeat(6,minmax(0,1fr));
    gap:10px;
    margin-top:12px;
  }

  #PUV2-{{ section.id }} .puv2-gallery__thumb {
    padding:0;
    aspect-ratio:1/1;
    overflow:hidden;
    border:1px solid var(--puv2-border);
    border-radius:10px;
    background:#fff;
    cursor:pointer;
  }

  #PUV2-{{ section.id }} .puv2-gallery__thumb.is-active { border:2px solid var(--puv2-accent); }
  #PUV2-{{ section.id }} .puv2-gallery__thumb-image { width:100%; height:100%; object-fit:cover; display:block; }

  #PUV2-{{ section.id }} .puv2-info { min-width:0; padding-top:3px; }

  #PUV2-{{ section.id }} .puv2-eyebrow {
    display:inline-flex;
    align-items:center;
    min-height:30px;
    padding:6px 12px;
    margin-bottom:14px;
    border:1px solid var(--puv2-border);
    border-radius:999px;
    background:rgba(255,255,255,.55);
    color:var(--puv2-dark);
    font-size:12px;
    font-weight:800;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  #PUV2-{{ section.id }} .puv2-title {
    margin:0;
    color:var(--puv2-dark);
    font-family:var(--font-heading-family,inherit);
    font-size:clamp(35px,3.15vw,48px);
    line-height:1.04;
    letter-spacing:-.034em;
    font-weight:800;
  }

  #PUV2-{{ section.id }} .puv2-status { margin-top:14px; }

  #PUV2-{{ section.id }} .puv2-stock {
    display:inline-flex;
    align-items:center;
    gap:8px;
    color:#25864d;
    font-size:14px;
    font-weight:750;
  }

  #PUV2-{{ section.id }} .puv2-stock i {
    width:9px;
    height:9px;
    border-radius:50%;
    background:currentColor;
    box-shadow:0 0 0 4px rgba(37,134,77,.11);
  }

  #PUV2-{{ section.id }} .puv2-stock.is-out { color:#a64b3d; }

  #PUV2-{{ section.id }} .puv2-price-row {
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:10px;
    margin-top:20px;
  }

  #PUV2-{{ section.id }} .puv2-price {
    color:var(--puv2-dark);
    font-size:34px;
    line-height:1;
    font-weight:800;
    letter-spacing:-.02em;
  }

  #PUV2-{{ section.id }} .puv2-compare {
    color:#a69a91;
    font-size:17px;
    text-decoration:line-through;
  }

  #PUV2-{{ section.id }} .puv2-sale {
    display:inline-flex;
    align-items:center;
    min-height:30px;
    padding:6px 10px;
    border:1px solid rgba(204,99,63,.15);
    border-radius:999px;
    background:#fff3ee;
    color:#c05b3d;
    font-size:12px;
    font-weight:800;
  }

  #PUV2-{{ section.id }} .puv2-benefit {
    margin:14px 0 0;
    color:var(--puv2-muted);
    font-size:16px;
    line-height:1.55;
  }

  #PUV2-{{ section.id }} .puv2-form { margin-top:26px; }

  #PUV2-{{ section.id }} .puv2-option {
    margin:0 0 19px;
    padding:0;
    border:0;
  }

  #PUV2-{{ section.id }} .puv2-label {
    display:block;
    margin:0 0 9px;
    padding:0;
    color:var(--puv2-dark);
    font-size:17px;
    line-height:1.3;
    font-weight:800;
  }

  #PUV2-{{ section.id }} .puv2-select-wrap { position:relative; }

  #PUV2-{{ section.id }} .puv2-select {
    width:100%;
    height:58px;
    padding:0 50px 0 16px;
