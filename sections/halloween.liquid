      margin-bottom: 7px !important;
      font-size: 13.5px !important;
    }

    .pb-related-center .price-item,
    .pb-related-center .price-item--regular,
    .pb-related-center .price-item--sale,
    .pb-related-center .product-card__price,
    .pb-related-center .product-item__price {
      font-size: 15px !important;
    }
  }

</style>

<script>
(() => {
  const root = document.getElementById('PUV2-{{ section.id }}');
  if (!root) return;

  /* Current products are expected to use normal Shopify variant counts.
     The UI itself is rendered from product.options_with_values. */
  const variants = [
    {% for variant in product.variants %}
      {
        id: {{ variant.id | json }},
        options: {{ variant.options | json }},
        available: {{ variant.available | json }},
        price: {{ variant.price | money | json }},
        compare: {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %},
        save: {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price }}{% else %}0{% endif %},
        mediaId: {% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  /* Gallery */
  const panels = Array.from(root.querySelectorAll('[data-puv2-media-index]'));
  const thumbs = Array.from(root.querySelectorAll('[data-puv2-thumb]'));
  const currentEl = root.querySelector('[data-puv2-current]');
  let currentIndex = 0;

  function showMedia(index) {
    if (!panels.length) return;
    index = Math.max(0, Math.min(index, panels.length - 1));
    currentIndex = index;

    panels.forEach((panel, i) => {
      const active = i === index;
      panel.hidden = !active;
      panel.classList.toggle('is-active', active);
    });

    thumbs.forEach((thumb, i) => thumb.classList.toggle('is-active', i === index));
    if (currentEl) currentEl.textContent = String(index + 1);
  }

  thumbs.forEach(thumb => {
    thumb.addEventListener('click', () => showMedia(Number(thumb.dataset.puv2Thumb || 0)));
  });

  root.querySelector('[data-puv2-prev]')?.addEventListener('click', () => {
    showMedia(currentIndex <= 0 ? panels.length - 1 : currentIndex - 1);
  });

  root.querySelector('[data-puv2-next]')?.addEventListener('click', () => {
    showMedia(currentIndex >= panels.length - 1 ? 0 : currentIndex + 1);
  });

  function showMediaById(mediaId) {
    if (!mediaId) return;
    const index = panels.findIndex(panel => String(panel.dataset.puv2MediaId) === String(mediaId));
    if (index >= 0) showMedia(index);
  }

  /* Variant engine */
  const variantId = root.querySelector('[data-puv2-variant-id]');
  const priceEl = root.querySelector('[data-puv2-price]');
  const compareEl = root.querySelector('[data-puv2-compare]');
  const saleEl = root.querySelector('[data-puv2-sale]');
  const stockEl = root.querySelector('[data-puv2-stock]');
  const stockText = root.querySelector('[data-puv2-stock-text]');
  const atc = root.querySelector('[data-puv2-atc]');
  const atcText = root.querySelector('[data-puv2-atc-text]');

  const addText = {{ section.settings.add_to_cart_text | json }};
  const soldText = {{ section.settings.sold_out_text | json }};
  const unavailableText = {{ section.settings.unavailable_text | json }};
  const inStockText = {{ section.settings.in_stock_text | json }};

  const initialSelectedOptions = {{ current_variant.options | json }};

  function selectedOptions() {
    const wanted = Array.isArray(initialSelectedOptions) ? [...initialSelectedOptions] : [];

    Array.from(root.querySelectorAll('[data-puv2-option-index]')).forEach(group => {
      const index = Number(group.dataset.puv2OptionIndex || 0);
      const checked = group.querySelector('[data-puv2-option-value]:checked');
      const select = group.querySelector('[data-puv2-option-select]');
      const value = checked ? checked.value : (select ? select.value : '');

      if (value) wanted[index] = value;
    });

    return wanted;
  }

  function findVariantForOptions(wanted) {
    if (!variants.length) return null;

    return variants.find(variant =>
      variant.options.length === wanted.length &&
      variant.options.every((value, index) => value === wanted[index])
    ) || null;
  }

  function findVariant() {
    return findVariantForOptions(selectedOptions());
  }

  function refreshDropdownPrices() {
    const current = selectedOptions();

    root.querySelectorAll('[data-puv2-option-select]').forEach(select => {
      const group = select.closest('[data-puv2-option-index]');
      if (!group) return;

      const optionIndex = Number(group.dataset.puv2OptionIndex || 0);

      Array.from(select.options).forEach(optionEl => {
        const baseLabel = optionEl.dataset.puv2BaseLabel || optionEl.value;
        const candidate = [...current];
        candidate[optionIndex] = optionEl.value;
        const candidateVariant = findVariantForOptions(candidate);

        if (candidateVariant) {
          optionEl.textContent = `${baseLabel} (${candidateVariant.price})${candidateVariant.available ? '' : ' — ' + soldText}`;
        } else {
          optionEl.textContent = `${baseLabel} — ${unavailableText}`;
        }
      });
    });
  }

  function renderVariant(variant) {
    if (!variant) {
      if (variantId) variantId.value = '';
      if (atc) atc.disabled = true;
      if (atcText) atcText.textContent = unavailableText;
      if (stockEl) stockEl.classList.add('is-out');
      if (stockText) stockText.textContent = unavailableText;
      return;
    }

    if (variantId) variantId.value = variant.id;
    if (priceEl) priceEl.textContent = variant.price;

    if (compareEl) {
      compareEl.textContent = variant.compare || '';
      compareEl.classList.toggle('is-hidden', !variant.compare);
    }

    if (saleEl) {
      saleEl.textContent = `SAVE ${variant.save}%`;
      saleEl.classList.toggle('is-hidden', !variant.save);
    }

    if (stockEl) stockEl.classList.toggle('is-out', !variant.available);
    if (stockText) stockText.textContent = variant.available ? inStockText : soldText;
    if (atc) atc.disabled = !variant.available;
    if (atcText) atcText.textContent = variant.available ? addText : soldText;

    showMediaById(variant.mediaId);

    try {
      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      history.replaceState({}, '', url);
    } catch (e) {}
  }

  root.querySelectorAll('[data-puv2-option-value]').forEach(input => {
    input.addEventListener('change', () => {
      renderVariant(findVariant());
      refreshDropdownPrices();
    });
  });

  root.querySelectorAll('[data-puv2-option-select]').forEach(select => {
    select.addEventListener('change', () => {
      renderVariant(findVariant());
      refreshDropdownPrices();
    });
  });

  /* Personalization counter */
  const personalization = root.querySelector('[data-puv2-personalization]');
  const charCount = root.querySelector('[data-puv2-char-count]');

  function updateCharCount() {
    if (personalization && charCount) {
      charCount.textContent = String(personalization.value.length);
    }
  }

  personalization?.addEventListener('input', updateCharCount);
  updateCharCount();

  /* Quantity */
  const qty = root.querySelector('[data-puv2-qty]');

  function clampQty(value) {
    return Math.min(99, Math.max(1, parseInt(value || '1', 10) || 1));
  }

  root.querySelector('[data-puv2-minus]')?.addEventListener('click', () => {
    if (qty) qty.value = clampQty(Number(qty.value) - 1);
  });

  root.querySelector('[data-puv2-plus]')?.addEventListener('click', () => {
    if (qty) qty.value = clampQty(Number(qty.value) + 1);
  });

  qty?.addEventListener('change', () => { qty.value = clampQty(qty.value); });

  refreshDropdownPrices();
  renderVariant(findVariant());
})();
</script>


<script>
  (() => {
    const relatedLabels = [
      'you may also like',
      'you might also like',
      'related products',
      'trending now',
      'featured collection'
    ];

    const markRelatedSection = () => {
      const headings = document.querySelectorAll('h1, h2, h3, h4, .title, .section-heading');
      headings.forEach((heading) => {
        const label = (heading.textContent || '').trim().toLowerCase().replace(/\s+/g, ' ');
        if (!relatedLabels.some((target) => label === target || label.includes(target))) return;

        const section = heading.closest('.shopify-section')
          || heading.closest('section')
          || heading.parentElement;

        if (section) section.classList.add('pb-related-center');
      });
    };

    markRelatedSection();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', markRelatedSection, { once: true });
    }

    const observer = new MutationObserver(markRelatedSection);
    observer.observe(document.documentElement, { childList: true, subtree: true });
    window.setTimeout(() => observer.disconnect(), 8000);
  })();
</script>

