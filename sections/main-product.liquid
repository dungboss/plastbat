  /* ==========================================================
     RELATED / "YOU MAY ALSO LIKE" CARD ALIGNMENT
     Applied only to the recommendation section detected below.
     Keeps title + price visually centered inside the lower card box.
     ========================================================== */
  /* Dawn-style cards contain a second title block inside .card__inner.
     The theme intentionally hides/controls that copy. V3 accidentally forced
     every .card__information block to flex, which exposed it over the image.
     Only style the information panel that is a direct child of the outer card content. */
  .pb-related-center .card > .card__content > .card__information,
  .pb-related-center .product-card__info,
  .pb-related-center .product-item__info {
    min-height: 108px;
    padding: 14px 14px 16px !important;
    display: flex !important;
    flex-direction: column;
    justify-content: center !important;
    align-items: center !important;
    box-sizing: border-box;
    text-align: center !important;
  }

  .pb-related-center .card__heading,
  .pb-related-center .card__heading.h5,
  .pb-related-center .product-card__title,
  .pb-related-center .product-item__title {
    width: 100%;
    margin: 0 0 8px !important;
    color: #594235 !important;
    font-size: 15px !important;
    line-height: 1.28 !important;
    font-weight: 800 !important;
    text-align: center !important;
  }

  .pb-related-center .card__heading a,
  .pb-related-center .product-card__title a,
  .pb-related-center .product-item__title a {
    display: -webkit-box;
    width: 100%;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    text-align: center !important;
    text-decoration: none;
  }

  .pb-related-center .card-information,
  .pb-related-center .price,
  .pb-related-center .price__container,
  .pb-related-center .product-card__price,
  .pb-related-center .product-item__price {
    width: 100%;
    margin: 0 !important;
    color: #594235;
    text-align: center !important;
  }

  .pb-related-center .price__container {
    display: flex !important;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center !important;
    gap: 6px;
  }

  .pb-related-center .price-item,
  .pb-related-center .price-item--regular,
  .pb-related-center .price-item--sale,
  .pb-related-center .product-card__price,
  .pb-related-center .product-item__price {
    font-size: 17px !important;
    line-height: 1.2 !important;
    font-weight: 750 !important;
  }

  .pb-related-center .price--on-sale .price-item--regular {
    font-size: 14px !important;
    font-weight: 500 !important;
    opacity: .55;
  }

  @media (max-width: 749px) {
    .pb-related-center .card > .card__content > .card__information,
    .pb-related-center .product-card__info,
    .pb-related-center .product-item__info {
      min-height: 98px;
      padding: 12px 10px 14px !important;
    }

    .pb-related-center .card__heading,
    .pb-related-center .card__heading.h5,
    .pb-related-center .product-card__title,
    .pb-related-center .product-item__title {
      margin-bottom: 7px !important;
      font-size: 13.5px !important;
    }

    .pb-related-center .price-item,
    .pb-related-center .price-item--regular,
    .pb-related-center .price-item--sale,
    .pb-related-center .product-card__price,
    .pb-related-center .product-item__price {
      font-size: 15px !important;
    }
  }



  /* ==========================================================
     REVIEWS — COMPACT MACORNER-INSPIRED LAYOUT
     10 REVIEWS PER PAGE + FILTERS + REVIEW MODAL
     ========================================================== */
  .pb-reviews-section {
    background: #f8f6f3;
    color: #5a4437;
    padding: 30px 0 44px;
    border-top: 1px solid #eee5dd;
    font-family: var(--font-body-family, inherit);
  }

  .pb-reviews-panel {
    width: min(100%, 1080px);
    margin: 0 auto;
    padding: 24px 26px;
    border: 1px solid #e5d8cc;
    border-radius: 16px;
    background: #fffdfa;
    box-shadow: 0 10px 28px rgba(82, 60, 45, .04);
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 34px;
    align-items: start;
  }

  .pb-reviews-summary {
    padding-right: 24px;
    border-right: 1px solid #eadfd5;
  }

  .pb-reviews-summary__title {
    margin: 0 0 16px;
    color: #594235;
    font-family: var(--font-heading-family, inherit);
    font-size: 22px;
    line-height: 1.1;
    font-weight: 780;
  }

  .pb-reviews-summary__score {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 20px;
  }

  .pb-reviews-summary__score > strong {
    color: #594235;
    font-size: 36px;
    line-height: 1;
    font-weight: 850;
  }

  .pb-reviews-summary__score > div {
    display: grid;
    gap: 4px;
  }

  .pb-reviews-summary__stars,
  .pb-review-card__stars {
    color: #ded3ca;
    letter-spacing: 1px;
    line-height: 1;
  }

  .pb-reviews-summary__stars {
    color: #f0642b;
    font-size: 15px;
  }

  .pb-reviews-summary__score span,
  .pb-reviews-summary__empty {
    color: #96867c;
    font-size: 12px;
  }

  .pb-review-histogram {
    display: grid;
    gap: 8px;
  }

  .pb-review-histogram__row {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 34px;
    gap: 8px;
    align-items: center;
    color: #88786e;
    font-size: 11.5px;
  }

  .pb-review-histogram__track {
    height: 6px;
    overflow: hidden;
    border-radius: 99px;
    background: #eee7e1;
  }

  .pb-review-histogram__track i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: #c58a52;
  }

  .pb-review-histogram__row b {
    color: #8b7a70;
    text-align: right;
    font-weight: 650;
  }

  .pb-reviews-main {
    min-width: 0;
  }

  .pb-reviews-main__title {
    margin: 0 0 12px;
    color: #594235;
    font-size: 20px;
    line-height: 1.2;
    font-weight: 780;
  }

  .pb-review-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 6px;
  }

  .pb-review-filter {
    min-height: 36px;
    padding: 0 13px;
    border: 1px solid #e8dfd8;
    border-radius: 999px;
    background: #fff;
    color: #796a61;
    font: inherit;
    font-size: 11.5px;
    font-weight: 650;
    cursor: pointer;
    transition: .16s ease;
  }

  .pb-review-filter:hover:not(:disabled) {
    border-color: #8c7668;
    color: #594235;
  }

  .pb-review-filter.is-active {
    border-color: #5e4b40;
    color: #4f3d33;
    box-shadow: inset 0 0 0 1px #5e4b40;
  }

  .pb-review-filter:disabled {
    opacity: .32;
    cursor: not-allowed;
  }

  .pb-review-list {
    display: grid;
  }

  .pb-review-card {
    padding: 17px 0;
    border-bottom: 1px solid #eee6df;
    cursor: pointer;
    outline: none;
  }

  .pb-review-card:hover {
    background: linear-gradient(90deg, rgba(246,239,231,.45), transparent 70%);
  }

  .pb-review-card:focus-visible {
    box-shadow: inset 0 0 0 2px #c58a52;
    border-radius: 8px;
  }

  .pb-review-card[hidden] {
    display: none !important;
  }

  .pb-review-card__headline {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pb-review-card__stars {
    display: flex;
    gap: 0;
    font-size: 13px;
  }

  .pb-review-card__stars .is-on {
    color: #f0642b;
  }

  .pb-review-card__author {
    color: #403733;
    font-size: 12.5px;
    font-weight: 700;
  }

  .pb-review-card__meta {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 6px;
    color: #a09289;
    font-size: 10.5px;
  }

  .pb-review-card__title {
    margin: 9px 0 4px;
    color: #55453d;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 760;
  }

  .pb-review-card__body {
    color: #655a54;
    font-size: 12.5px;
    line-height: 1.55;
  }

  .pb-review-card__body > :first-child,
  .pb-review-card__body > :last-child {
    margin-top: 0;
    margin-bottom: 0;
  }

  .pb-review-card__thumb-wrap {
    margin-top: 9px;
  }

  .pb-review-card__thumb {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #e3d9d1;
    display: block;
  }

  .pb-review-pagination {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 5px;
    margin-top: 14px;
    min-height: 34px;
  }

  .pb-review-pagination button {
    min-width: 31px;
    height: 31px;
    padding: 0 8px;
    border: 1px solid #e5ddd7;
    border-radius: 999px;
    background: #fff;
    color: #796a61;
    font: inherit;
    font-size: 11.5px;
    cursor: pointer;
  }

  .pb-review-pagination button.is-active {
    background: #665246;
    border-color: #665246;
    color: #fff;
  }

  .pb-review-pagination button:disabled {
    opacity: .35;
    cursor: not-allowed;
  }

  /* REVIEW MODAL */
  .pb-review-modal[hidden] {
    display: none !important;
  }

  .pb-review-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 20px;
  }

  .pb-review-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(41, 35, 38, .72);
  }

  .pb-review-modal__dialog {
    position: relative;
    z-index: 1;
    width: min(860px, calc(100vw - 54px));
    max-height: min(620px, calc(100vh - 56px));
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 22px 70px rgba(0,0,0,.28);
    overflow: visible;
  }

  .pb-review-modal__content {
    max-height: min(620px, calc(100vh - 56px));
    overflow: hidden;
    border-radius: inherit;
  }

  .pb-review-modal__close {
    position: absolute;
    top: -14px;
    right: -14px;
    z-index: 4;
    width: 36px;
    height: 36px;
    border: 1px solid #e6ded8;
    border-radius: 999px;
    background: #fff;
    color: #4f423c;
    font-size: 23px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0,0,0,.12);
  }

  .pb-review-modal__arrow {
    position: absolute;
    top: 50%;
    z-index: 4;
    width: 40px;
    height: 40px;
    transform: translateY(-50%);
    border: 1px solid #ece3dd;
    border-radius: 999px;
    background: #fff;
    color: #58483f;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0,0,0,.1);
  }

  .pb-review-modal__arrow--prev { left: -20px; }
  .pb-review-modal__arrow--next { right: -20px; }

  .pb-review-modal-source {
    display: grid;
    grid-template-columns: 49% 51%;
    min-height: 390px;
    max-height: min(620px, calc(100vh - 56px));
  }

  .pb-review-modal-source.is-no-image {
    grid-template-columns: 1fr;
  }

  .pb-review-modal-source__media {
    min-width: 0;
    padding: 16px;
    border-right: 1px solid #eee6df;
    background: #fffdfb;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .pb-review-modal-source__image {
    width: 100%;
    height: 100%;
    max-height: 500px;
    object-fit: contain;
    border-radius: 8px;
  }

  .pb-review-modal-source__details {
    min-width: 0;
    padding: 22px 22px 26px;
    overflow-y: auto;
    color: #554944;
  }

  .pb-review-modal-source__headline {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pb-review-modal-source__headline strong {
    color: #403733;
    font-size: 13px;
  }

