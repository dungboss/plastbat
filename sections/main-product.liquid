<script>
  (() => {
    const root = document.getElementById('PBProductMain-{{ section.id }}');
    if (!root || root.dataset.pbReady === 'true') return;
    root.dataset.pbReady = 'true';

    // Gallery
    const panels = [...root.querySelectorAll('[data-pb-media]')];
    const thumbs = [...root.querySelectorAll('[data-pb-thumb]')];
    const currentCounter = root.querySelector('[data-pb-current]');
    let activeIndex = 0;

    const showMedia = (index) => {
      if (!panels.length) return;
      activeIndex = (index + panels.length) % panels.length;
      panels.forEach((panel, i) => {
        const active = i === activeIndex;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });
      thumbs.forEach((thumb, i) => {
        const active = i === activeIndex;
        thumb.classList.toggle('is-active', active);
        thumb.setAttribute('aria-current', active ? 'true' : 'false');
      });
      if (currentCounter) currentCounter.textContent = activeIndex + 1;
      const activeThumb = thumbs[activeIndex];
      if (activeThumb && window.innerWidth < 750) {
        activeThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    };

    thumbs.forEach((thumb) => thumb.addEventListener('click', () => showMedia(Number(thumb.dataset.pbThumb))));
    root.querySelector('[data-pb-prev]')?.addEventListener('click', () => showMedia(activeIndex - 1));
    root.querySelector('[data-pb-next]')?.addEventListener('click', () => showMedia(activeIndex + 1));

    // Color selection + summary
    const colorInputs = [...root.querySelectorAll('input[name="properties[Color]"]')];
    const selectedColor = root.querySelector('[data-pb-selected-color]');
    const summaryColor = root.querySelector('[data-pb-summary-color]');
    const personalization = root.querySelector('[data-pb-personalization]');
    const summaryName = root.querySelector('[data-pb-summary-name]');
    const charCount = root.querySelector('[data-pb-char-count]');

    const syncCustomization = () => {
      const color = colorInputs.find((input) => input.checked)?.value || 'Choose a color';
      const name = personalization?.value.trim() || 'Add your name above';
      if (selectedColor) selectedColor.textContent = color;
      if (summaryColor) summaryColor.textContent = color;
      if (summaryName) summaryName.textContent = name;
      if (charCount && personalization) charCount.textContent = personalization.value.length;
    };

    colorInputs.forEach((input) => input.addEventListener('change', syncCustomization));
    personalization?.addEventListener('input', syncCustomization);
    syncCustomization();

    // Quantity
    const qty = root.querySelector('.pb-qty__input');
    const clampQty = (value) => Math.min(99, Math.max(1, Number.parseInt(value || '1', 10) || 1));
    root.querySelector('[data-pb-minus]')?.addEventListener('click', () => {
      if (!qty) return;
      qty.value = clampQty(Number(qty.value) - 1);
    });
    root.querySelector('[data-pb-plus]')?.addEventListener('click', () => {
      if (!qty) return;
      qty.value = clampQty(Number(qty.value) + 1);
    });
    qty?.addEventListener('change', () => { qty.value = clampQty(qty.value); });

    // Variant/price sync
    const variantSelect = root.querySelector('[data-pb-variant-select]');
    const price = root.querySelector('[data-pb-price]');
    const mobilePrice = root.querySelector('[data-pb-mobile-price]');
    const compare = root.querySelector('[data-pb-compare]');
    const sale = root.querySelector('[data-pb-sale]');
    const atc = root.querySelector('[data-pb-atc]');
    const atcText = root.querySelector('[data-pb-atc-text]');
    const mobileAtc = root.querySelector('[data-pb-mobile-atc]');
    const addText = {{ section.settings.add_to_cart_text | json }};
    const soldText = {{ section.settings.sold_out_text | json }};

    const syncVariant = () => {
      if (!variantSelect) return;
      const option = variantSelect.options[variantSelect.selectedIndex];
      const isAvailable = option?.dataset.available === 'true';
      const priceText = option?.dataset.price || '';
      const compareText = option?.dataset.compare || '';
      const save = Number(option?.dataset.save || 0);

      if (price && priceText) price.textContent = priceText;
      if (mobilePrice && priceText) mobilePrice.textContent = priceText;
      if (compare) {
        compare.textContent = compareText;
        compare.classList.toggle('is-hidden', !compareText);
      }
      if (sale) {
        sale.textContent = `Save ${save}%`;
        sale.classList.toggle('is-hidden', save <= 0);
      }
      if (atc) atc.disabled = !isAvailable;
      if (mobileAtc) mobileAtc.disabled = !isAvailable;
      if (atcText) atcText.textContent = isAvailable ? addText : soldText;
      if (mobileAtc) mobileAtc.textContent = isAvailable ? addText : soldText;
    };

    variantSelect?.addEventListener('change', syncVariant);
    syncVariant();

    // Prevent accidental whitespace-only personalization when required.
    const form = root.querySelector('#{{ product_form_id }}');
    form?.addEventListener('submit', (event) => {
      if (personalization && personalization.required && personalization.value.trim() === '') {
        event.preventDefault();
        personalization.value = '';
        personalization.focus();
        personalization.reportValidity();
      }
    });
  })();
</script>

<script>
  (() => {
    const relatedLabels = [
      'you may also like',
      'you might also like',
      'related products',
      'trending now'
    ];

    const markRelatedSection = () => {
      const headings = document.querySelectorAll('h1, h2, h3, h4, .title, .section-heading');
      headings.forEach((heading) => {
        const label = (heading.textContent || '').trim().toLowerCase().replace(/\s+/g, ' ');
        if (!relatedLabels.some((target) => label === target || label.includes(target))) return;

        const section = heading.closest('.shopify-section')
          || heading.closest('section')
          || heading.parentElement;

        if (section) section.classList.add('pb-related-center');
      });
    };

    markRelatedSection();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', markRelatedSection, { once: true });
    }

    // Shopify recommendation blocks can be injected after page load.
    const observer = new MutationObserver(markRelatedSection);
    observer.observe(document.documentElement, { childList: true, subtree: true });
    window.setTimeout(() => observer.disconnect(), 8000);
  })();
</script>


<script>
  (() => {
    const section = document.getElementById('pb-reviews-{{ section.id }}');
    if (!section || section.dataset.pbReviewsReady === 'true') return;
    section.dataset.pbReviewsReady = 'true';

    const pageSize = 10;
    const cards = [...section.querySelectorAll('[data-pb-review-card]')];
    const filters = [...section.querySelectorAll('.pb-review-filter')];
    const pagination = section.querySelector('[data-pb-review-pagination]');
    const modal = section.querySelector('[data-pb-review-modal]');
    const modalContent = section.querySelector('[data-pb-review-modal-content]');
    const modalPrev = section.querySelector('[data-pb-modal-prev]');
    const modalNext = section.querySelector('[data-pb-modal-next]');

    let activeRating = 'all';
    let currentPage = 1;
    let modalIndex = -1;

    const filteredCards = () => {
      if (activeRating === 'all') return cards;
      return cards.filter((card) => card.dataset.rating === activeRating);
    };

    const renderPagination = () => {
      if (!pagination) return;

      const list = filteredCards();
      const totalPages = Math.max(1, Math.ceil(list.length / pageSize));

      if (currentPage > totalPages) currentPage = totalPages;
      pagination.innerHTML = '';

      if (list.length <= pageSize) {
        pagination.hidden = true;
        return;
      }

      pagination.hidden = false;

      const makeButton = (label, page, { active = false, disabled = false } = {}) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = label;
        button.dataset.page = page;
        button.disabled = disabled;
        if (active) button.classList.add('is-active');
        return button;
      };

      pagination.appendChild(
        makeButton('‹', currentPage - 1, { disabled: currentPage === 1 })
      );

      for (let page = 1; page <= totalPages; page += 1) {
        pagination.appendChild(
          makeButton(String(page), page, { active: page === currentPage })
        );
      }

      pagination.appendChild(
        makeButton('›', currentPage + 1, { disabled: currentPage === totalPages })
      );
    };

    const renderReviews = ({ scroll = false } = {}) => {
      const list = filteredCards();
      const start = (currentPage - 1) * pageSize;
      const end = start + pageSize;
      const pageCards = list.slice(start, end);

      cards.forEach((card) => {
        card.hidden = !pageCards.includes(card);
      });

      renderPagination();

      if (scroll) {
        section.querySelector('.pb-reviews-main__title')?.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    };

    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        if (filter.disabled) return;

        filters.forEach((item) => item.classList.remove('is-active'));
        filter.classList.add('is-active');

        activeRating = filter.dataset.rating || 'all';
        currentPage = 1;
        renderReviews();
      });
    });

    pagination?.addEventListener('click', (event) => {
      const button = event.target.closest('button[data-page]');
      if (!button || button.disabled) return;

      currentPage = Number(button.dataset.page || 1);
      renderReviews({ scroll: true });
    });

    const closeModal = () => {
      if (!modal) return;
      modal.hidden = true;
      document.body.classList.remove('pb-review-modal-open');
      modalIndex = -1;
    };

    const openModalAt = (index) => {
      const list = filteredCards();
      if (!modal || !modalContent || !list.length) return;

      modalIndex = (index + list.length) % list.length;
      const card = list[modalIndex];
      const source = card.querySelector('[data-pb-review-modal-source]');

      if (!source) return;

      modalContent.innerHTML = '';
      modalContent.appendChild(source.content.cloneNode(true));

      modalPrev.hidden = list.length <= 1;
      modalNext.hidden = list.length <= 1;

      modal.hidden = false;
      document.body.classList.add('pb-review-modal-open');
      section.querySelector('[data-pb-modal-close]:not(.pb-review-modal__backdrop)')?.focus();
    };

    const openCard = (card) => {
      const list = filteredCards();
      const index = list.indexOf(card);
      if (index >= 0) openModalAt(index);
    };

    cards.forEach((card) => {
      card.addEventListener('click', () => openCard(card));
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openCard(card);
        }
      });
    });

    section.querySelectorAll('[data-pb-modal-close]').forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    modalPrev?.addEventListener('click', () => openModalAt(modalIndex - 1));
    modalNext?.addEventListener('click', () => openModalAt(modalIndex + 1));

    document.addEventListener('keydown', (event) => {
      if (!modal || modal.hidden) return;

      if (event.key === 'Escape') closeModal();
      if (event.key === 'ArrowLeft') openModalAt(modalIndex - 1);
      if (event.key === 'ArrowRight') openModalAt(modalIndex + 1);
    });

    renderReviews();
  })();
</script>

