
{% comment %}
  PLASTBAT — Conversion Product Main Section V4
  File: sections/plastbat-product-main.liquid

  V5 HOTFIX:
  - Adds an editable rich-text field for the Description accordion in Theme Editor.
  - If Description text is left blank, the section automatically falls back to product.description.

  V4 HOTFIX:
  - Fixes duplicate/overlay product titles appearing on top of related-product images.
  - Centers only the real information panel below each product image.
  - Does not force Shopify/Dawn's hidden media-card title block to display.

  V2 CHANGES:
  - Larger typography and roomier option controls.
  - Warm cream / caramel / brown palette aligned with the current Plastbat storefront.
  - Color choices use 3-column readable cards instead of tiny 6-column tiles.
  - Product gallery is sticky on desktop and releases at the end of the product section.
  - Product information scrolls normally, reducing the empty-left-column effect.

  INSTALL:
  1) Shopify Admin → Online Store → Themes → ... → Edit code
  2) Sections → Add a new section → name it: plastbat-product-main
  3) Paste this entire file and Save.
  4) Open Customize → Product template → Add section → “Plastbat — Product Main”
  5) Hide/remove the old Main product section on that product template.

  COLOR METAFIELD:
  This section first reads: product.metafields.custom.colors
  Your screenshot shows a “Colors” metaobject list, so this is the most likely path.
  If your metafield namespace/key is different, change ONLY this line below:
    assign product_colors = product.metafields.custom.colors.value

  The selected Color and Personalization are saved as Shopify line-item properties,
  so they appear with the order in Shopify Admin.
{% endcomment %}

{% liquid
  assign personalization_limit = 10
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'pb-product-form-' | append: section.id
  assign product_colors = product.metafields.custom.colors.value
  assign use_metafield_colors = false
  if section.settings.use_colors_metafield and product_colors != blank
    assign use_metafield_colors = true
  endif

  assign fallback_color_names = 'Red|Orange|Gold|Beige|Yellow|Brown|Green|Blue|Navy|Grey|Purple|Black|White|Turquoise|Olive|Light Pink|Cyan|Light Purple' | split: '|'
  assign fallback_color_hexes = '#EF2B2D|#F39A00|#C89B00|#E8D7AE|#FFD400|#A85B2D|#00A44B|#1467C9|#252A91|#92979B|#A64BD4|#0A0A0A|#FFFFFF|#34C9C2|#747A12|#F7B7C3|#00D9D9|#B15DDC' | split: '|'

  assign rating_object = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
%}

<section
  id="PBProductMain-{{ section.id }}"
  class="pb-product-main color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="
    --pb-radius: {{ section.settings.corner_radius }}px;
    --pb-soft: {{ section.settings.soft_background }};
    --pb-border: {{ section.settings.border_color }};
    --pb-accent-custom: {{ section.settings.accent_color }};
  "
>
  <div class="page-width pb-product-main__inner">
    <div class="pb-product-main__grid">
      <!-- MEDIA -->
      <div class="pb-gallery{% unless section.settings.sticky_gallery == false %} pb-gallery--sticky{% endunless %}" data-pb-gallery>
        <div class="pb-gallery__stage">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              {% assign media_alt = media.alt | default: product.title %}
              <div
                class="pb-gallery__panel{% if forloop.first %} is-active{% endif %}"
                data-pb-media="{{ forloop.index0 }}"
                {% unless forloop.first %}hidden{% endunless %}
              >
                {% case media.media_type %}
                  {% when 'image' %}
                    {{
                      media.preview_image
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'eager',
                        widths: '480, 720, 960, 1200, 1600',
                        sizes: '(min-width: 990px) 56vw, 100vw',
                        class: 'pb-gallery__image',
                        alt: media_alt
                    }}
                  {% when 'video' %}
                    {{ media | video_tag: controls: true, image_size: '1200x', class: 'pb-gallery__video' }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag: class: 'pb-gallery__video' }}
                  {% when 'model' %}
                    {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, class: 'pb-gallery__model' }}
                  {% else %}
                    {{
                      media.preview_image
                      | image_url: width: 1600
                      | image_tag: class: 'pb-gallery__image', alt: media_alt
                    }}
                {% endcase %}
              </div>
            {% endfor %}

            {% if product.media.size > 1 %}
              <button class="pb-gallery__arrow pb-gallery__arrow--prev" type="button" data-pb-prev aria-label="Previous image">
                <span aria-hidden="true">‹</span>
              </button>
              <button class="pb-gallery__arrow pb-gallery__arrow--next" type="button" data-pb-next aria-label="Next image">
                <span aria-hidden="true">›</span>
              </button>
              <div class="pb-gallery__counter" aria-live="polite">
                <span data-pb-current>1</span> / {{ product.media.size }}
              </div>
            {% endif %}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'pb-gallery__placeholder' }}
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="pb-gallery__thumbs" role="list" aria-label="Product media">
            {% for media in product.media %}
              {% assign thumb_alt = media.alt | default: product.title %}
              <button
                type="button"
                class="pb-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-pb-thumb="{{ forloop.index0 }}"
                aria-label="View media {{ forloop.index }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {{
                  media.preview_image
                  | image_url: width: 220
                  | image_tag: loading: 'lazy', class: 'pb-gallery__thumb-image', alt: thumb_alt
                }}
                {% if media.media_type != 'image' %}
                  <span class="pb-gallery__media-icon" aria-hidden="true">▶</span>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- PRODUCT INFO -->
      <div class="pb-info">
        {% if section.settings.eyebrow != blank %}
          <div class="pb-eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {% endif %}

        <h1 class="pb-title">{{ product.title }}</h1>

        <div class="pb-meta-row">
          {% if rating_object != blank %}
            <a class="pb-rating" href="#pb-reviews-{{ section.id }}" aria-label="Product reviews">
              <span class="pb-rating__stars" aria-hidden="true">★★★★★</span>
              <span>
                {{ rating_object.rating | round: 1 }}{% if rating_count != blank %} ({{ rating_count }}){% endif %}
              </span>
            </a>
          {% elsif section.settings.fallback_social_proof != blank %}
            <span class="pb-social-proof">{{ section.settings.fallback_social_proof | escape }}</span>
          {% endif %}

          {% if current_variant.available %}
            <span class="pb-stock pb-stock--in"><i></i>{{ section.settings.in_stock_text | escape }}</span>
          {% else %}
            <span class="pb-stock pb-stock--out"><i></i>{{ section.settings.sold_out_text | escape }}</span>
          {% endif %}
        </div>

        <div class="pb-price-wrap" aria-live="polite">
          <span class="pb-price" data-pb-price>{{ current_variant.price | money }}</span>
          <span
            class="pb-compare-price{% unless current_variant.compare_at_price > current_variant.price %} is-hidden{% endunless %}"
            data-pb-compare
          >
            {% if current_variant.compare_at_price > current_variant.price %}
              {{ current_variant.compare_at_price | money }}
            {% endif %}
          </span>
          {% if current_variant.compare_at_price > current_variant.price %}
            {% assign initial_save = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price %}
          {% else %}
            {% assign initial_save = 0 %}
          {% endif %}
          <span class="pb-sale-badge{% if initial_save == 0 %} is-hidden{% endif %}" data-pb-sale>
            Save {{ initial_save }}%
          </span>
        </div>

        {% if section.settings.short_benefit != blank %}
          <p class="pb-short-benefit">{{ section.settings.short_benefit | escape }}</p>
        {% endif %}

        {% form 'product', product, id: product_form_id, class: 'pb-product-form' %}
          {% if product.variants.size > 1 %}
            <div class="pb-field">
              <div class="pb-field__head">
                <label class="pb-label" for="PBVariant-{{ section.id }}">{{ section.settings.variant_label | escape }}</label>
              </div>
              <select class="pb-select" id="PBVariant-{{ section.id }}" name="id" data-pb-variant-select>
                {% for variant in product.variants %}
                  {% if variant.compare_at_price > variant.price %}
                    {% assign variant_save = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price %}
                  {% else %}
                    {% assign variant_save = 0 %}
                  {% endif %}
                  <option
                    value="{{ variant.id }}"
                    data-price="{{ variant.price | money | escape }}"
                    data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                    data-save="{{ variant_save }}"
                    data-available="{{ variant.available }}"
                    {% if variant.id == current_variant.id %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% endif %}

          <!-- COLOR -->
          <div class="pb-field pb-color-field pb-option-card">
            <div class="pb-field__head">
              <span class="pb-label">{{ section.settings.color_label | escape }}</span>
              <span class="pb-selected-value">Selected: <strong data-pb-selected-color>Choose a color</strong></span>
            </div>

            <div class="pb-swatches" role="radiogroup" aria-label="{{ section.settings.color_label | escape }}">
              {% if use_metafield_colors %}
                {% for color_item in product_colors %}
                  {% liquid
                    assign swatch_name = color_item.name.value | default: color_item.title.value | default: color_item.label.value | default: color_item.system.handle
                    assign swatch_hex = color_item.hex.value | default: color_item.color.value
                    if swatch_hex == blank
                      case swatch_name
                        when 'Red'
                          assign swatch_hex = '#EF2B2D'
                        when 'Orange'
                          assign swatch_hex = '#F39A00'
                        when 'Gold'
                          assign swatch_hex = '#C89B00'
                        when 'Beige'
                          assign swatch_hex = '#E8D7AE'
                        when 'Yellow'
                          assign swatch_hex = '#FFD400'
                        when 'Brown'
                          assign swatch_hex = '#A85B2D'
                        when 'Green'
                          assign swatch_hex = '#00A44B'
                        when 'Blue'
                          assign swatch_hex = '#1467C9'
                        when 'Navy'
                          assign swatch_hex = '#252A91'
                        when 'Grey', 'Gray'
                          assign swatch_hex = '#92979B'
                        when 'Purple'
                          assign swatch_hex = '#A64BD4'
                        when 'Black'
                          assign swatch_hex = '#0A0A0A'
                        when 'White'
                          assign swatch_hex = '#FFFFFF'
                        when 'Turquoise'
                          assign swatch_hex = '#34C9C2'
                        when 'Olive'
                          assign swatch_hex = '#747A12'
                        when 'Light Pink'
                          assign swatch_hex = '#F7B7C3'
                        when 'Cyan'
                          assign swatch_hex = '#00D9D9'
                        when 'Light Purple'
                          assign swatch_hex = '#B15DDC'
                        else
                          assign swatch_hex = '#D9D9D9'
                      endcase
                    endif
                  %}
                  <div class="pb-swatch-wrap">
                    <input
                      class="pb-swatch-input visually-hidden"
                      type="radio"
                      id="PBColor-{{ section.id }}-{{ forloop.index }}"
                      name="properties[Color]"
                      value="{{ swatch_name | escape }}"
                      {% if forloop.first %}checked{% endif %}
                      required
                    >
                    <label class="pb-swatch" for="PBColor-{{ section.id }}-{{ forloop.index }}" title="{{ swatch_name | escape }}">
                      <span class="pb-swatch__dot" style="--swatch: {{ swatch_hex }};"></span>
                      <span class="pb-swatch__name">{{ swatch_name }}</span>
                      <span class="pb-swatch__check" aria-hidden="true">✓</span>
                    </label>
                  </div>
                {% endfor %}
              {% else %}
                {% for swatch_name in fallback_color_names %}
                  {% assign swatch_hex = fallback_color_hexes[forloop.index0] %}
                  <div class="pb-swatch-wrap">
                    <input
                      class="pb-swatch-input visually-hidden"
                      type="radio"
                      id="PBColor-{{ section.id }}-{{ forloop.index }}"
                      name="properties[Color]"
                      value="{{ swatch_name | escape }}"
                      {% if forloop.first %}checked{% endif %}
                      required
                    >
                    <label class="pb-swatch" for="PBColor-{{ section.id }}-{{ forloop.index }}" title="{{ swatch_name | escape }}">
                      <span class="pb-swatch__dot" style="--swatch: {{ swatch_hex }};"></span>
                      <span class="pb-swatch__name">{{ swatch_name }}</span>
                      <span class="pb-swatch__check" aria-hidden="true">✓</span>
                    </label>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <!-- PERSONALIZATION -->
          <div class="pb-field pb-personalization pb-option-card">
            <div class="pb-field__head">
              <label class="pb-label" for="PBPersonalization-{{ section.id }}">{{ section.settings.personalization_label | escape }}</label>
              {% if section.settings.personalization_required %}
                <span class="pb-required-badge">Required</span>
              {% endif %}
            </div>
            <div class="pb-input-shell">
              <input
                class="pb-input"
                type="text"
                id="PBPersonalization-{{ section.id }}"
                name="properties[Personalization]"
                maxlength="{{ personalization_limit }}"
                placeholder="{{ section.settings.personalization_placeholder | escape }}"
                autocomplete="off"
                {% if section.settings.personalization_required %}required{% endif %}
                data-pb-personalization
              >
              <span class="pb-char-count"><b data-pb-char-count>0</b>/{{ personalization_limit }}</span>
            </div>
            {% if section.settings.personalization_help != blank %}
              <p class="pb-help">{{ section.settings.personalization_help | escape }}</p>
            {% endif %}
          </div>

          <!-- SELECTION SUMMARY -->
          <div class="pb-selection-summary" aria-live="polite">
            <span class="pb-selection-summary__icon" aria-hidden="true">✓</span>
            <div>
              <strong>Your customization</strong>
              <p><span data-pb-summary-color>Red</span><span data-pb-summary-separator> · </span><span data-pb-summary-name>Add your name above</span></p>
            </div>
          </div>

          <!-- QUANTITY + CTA -->
          <div class="pb-buy-row">
            <div class="pb-qty" data-pb-qty>
              <button type="button" class="pb-qty__button" data-pb-minus aria-label="Decrease quantity">−</button>
              <input class="pb-qty__input" type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" aria-label="Quantity">
              <button type="button" class="pb-qty__button" data-pb-plus aria-label="Increase quantity">+</button>
            </div>

            <button
              type="submit"
              name="add"
              class="pb-atc"
              data-pb-atc
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span data-pb-atc-text>{% if current_variant.available %}{{ section.settings.add_to_cart_text | escape }}{% else %}{{ section.settings.sold_out_text | escape }}{% endif %}</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>

          {% if section.settings.checkout_note != blank %}
            <p class="pb-checkout-note">🔒 {{ section.settings.checkout_note | escape }}</p>
          {% endif %}
        {% endform %}

        <!-- TRUST -->
        <div class="pb-trust-grid">
          {% if section.settings.trust_1 != blank %}
            <div class="pb-trust-card">
              <span class="pb-trust-card__icon" aria-hidden="true">✦</span>
              <span>{{ section.settings.trust_1 | escape }}</span>
            </div>
          {% endif %}
          {% if section.settings.trust_2 != blank %}
            <div class="pb-trust-card">
              <span class="pb-trust-card__icon" aria-hidden="true">↗</span>
              <span>{{ section.settings.trust_2 | escape }}</span>
            </div>
          {% endif %}
          {% if section.settings.trust_3 != blank %}
            <div class="pb-trust-card">
              <span class="pb-trust-card__icon" aria-hidden="true">♡</span>
              <span>{{ section.settings.trust_3 | escape }}</span>
            </div>
          {% endif %}
        </div>

        <!-- ACCORDIONS -->
        <div class="pb-accordions">
          <details class="pb-accordion" {% if section.settings.open_description %}open{% endif %}>
            <summary>
              <span>{{ section.settings.description_heading | escape }}</span>
              <span class="pb-accordion__plus" aria-hidden="true"></span>
            </summary>
            <div class="pb-accordion__content rte">
              {% if section.settings.description_body != blank %}
                {{ section.settings.description_body }}
              {% else %}
                {{ product.description }}
              {% endif %}
            </div>
          </details>

          {% if section.settings.details_text != blank %}
            <details class="pb-accordion">
              <summary>
                <span>{{ section.settings.details_heading | escape }}</span>
                <span class="pb-accordion__plus" aria-hidden="true"></span>
              </summary>
              <div class="pb-accordion__content rte">{{ section.settings.details_text }}</div>
            </details>
          {% endif %}

          {% if section.settings.shipping_text != blank %}
            <details class="pb-accordion">
              <summary>
                <span>{{ section.settings.shipping_heading | escape }}</span>
                <span class="pb-accordion__plus" aria-hidden="true"></span>
              </summary>
              <div class="pb-accordion__content rte">{{ section.settings.shipping_text }}</div>
            </details>
          {% endif %}

          {% if section.settings.personalization_info != blank %}
            <details class="pb-accordion">
              <summary>
                <span>{{ section.settings.personalization_heading | escape }}</span>
                <span class="pb-accordion__plus" aria-hidden="true"></span>
              </summary>
              <div class="pb-accordion__content rte">{{ section.settings.personalization_info }}</div>
            </details>
          {% endif %}
        </div>

      </div>
    </div>
  </div>

  <!-- MOBILE STICKY CTA -->
  {% if section.settings.mobile_sticky_atc %}
    <div class="pb-mobile-bar" data-pb-mobile-bar>
      <div class="pb-mobile-bar__price" data-pb-mobile-price>{{ current_variant.price | money }}</div>
      <button
        type="submit"
        form="{{ product_form_id }}"
        class="pb-mobile-bar__button"
        data-pb-mobile-atc
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {% if current_variant.available %}{{ section.settings.add_to_cart_text | escape }}{% else %}{{ section.settings.sold_out_text | escape }}{% endif %}
      </button>
    </div>
  {% endif %}

</section>

{% if section.settings.show_reviews %}
  <section
    id="pb-reviews-{{ section.id }}"
    class="pb-reviews-section color-{{ section.settings.color_scheme }}"
    data-pb-reviews-section
  >
    {% liquid
      assign pb_review_count = 0
      assign pb_rating_total = 0
      assign pb_count_5 = 0
      assign pb_count_4 = 0
      assign pb_count_3 = 0
      assign pb_count_2 = 0
      assign pb_count_1 = 0

      for block in section.blocks
        if block.type == 'manual_review'
          assign pb_review_count = pb_review_count | plus: 1
          assign pb_rating_total = pb_rating_total | plus: block.settings.rating

          case block.settings.rating
            when 5
              assign pb_count_5 = pb_count_5 | plus: 1
            when 4
              assign pb_count_4 = pb_count_4 | plus: 1
            when 3
              assign pb_count_3 = pb_count_3 | plus: 1
            when 2
              assign pb_count_2 = pb_count_2 | plus: 1
            when 1
              assign pb_count_1 = pb_count_1 | plus: 1
          endcase
        endif
      endfor

      if pb_review_count > 0
        assign pb_average_rating = pb_rating_total | times: 1.0 | divided_by: pb_review_count
      else
        assign pb_average_rating = 0
      endif
    %}

    <div class="page-width pb-reviews-section__inner">
      <div class="pb-reviews-panel">

        <aside class="pb-reviews-summary">
          <h2 class="pb-reviews-summary__title">{{ section.settings.reviews_heading | escape }}</h2>

          {% if pb_review_count > 0 %}
            <div class="pb-reviews-summary__score">
              <strong>{{ pb_average_rating | round: 1 }}</strong>
              <div>
                <div class="pb-reviews-summary__stars" aria-hidden="true">★★★★★</div>
                <span>Based on {{ pb_review_count }} review{% if pb_review_count != 1 %}s{% endif %}</span>
              </div>
            </div>

            <div class="pb-review-histogram" aria-label="Review distribution">
              {% assign pb_counts = pb_count_5 | append: ',' | append: pb_count_4 | append: ',' | append: pb_count_3 | append: ',' | append: pb_count_2 | append: ',' | append: pb_count_1 | split: ',' %}
              {% for star in (1..5) reversed %}
                {% assign index = 5 | minus: star %}
                {% assign star_count = pb_counts[index] | plus: 0 %}
                {% assign star_percent = star_count | times: 100 | divided_by: pb_review_count %}

                <div class="pb-review-histogram__row">
                  <span>{{ star }} Star</span>
                  <div class="pb-review-histogram__track">
                    <i style="width: {{ star_percent }}%;"></i>
                  </div>
                  <b>{{ star_percent }}%</b>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <p class="pb-reviews-summary__empty">{{ section.settings.no_reviews_text | escape }}</p>
          {% endif %}
        </aside>

        <div class="pb-reviews-main">
          <h3 class="pb-reviews-main__title">Top reviews</h3>

          {% if pb_review_count > 0 %}
            <div class="pb-review-filters" data-pb-review-filters>
              <button type="button" class="pb-review-filter is-active" data-rating="all">
                All Reviews ({{ pb_review_count }})
              </button>
              <button type="button" class="pb-review-filter" data-rating="5" {% if pb_count_5 == 0 %}disabled{% endif %}>
                5 Star ({{ pb_count_5 }})
              </button>
              <button type="button" class="pb-review-filter" data-rating="4" {% if pb_count_4 == 0 %}disabled{% endif %}>
                4 Star ({{ pb_count_4 }})
              </button>
              <button type="button" class="pb-review-filter" data-rating="3" {% if pb_count_3 == 0 %}disabled{% endif %}>
                3 Star ({{ pb_count_3 }})
              </button>
              <button type="button" class="pb-review-filter" data-rating="2" {% if pb_count_2 == 0 %}disabled{% endif %}>
                2 Star ({{ pb_count_2 }})
              </button>
              <button type="button" class="pb-review-filter" data-rating="1" {% if pb_count_1 == 0 %}disabled{% endif %}>
                1 Star ({{ pb_count_1 }})
              </button>
            </div>

            <div class="pb-review-list" data-pb-review-list>
              {% assign pb_review_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'manual_review' %}
                  <article
                    class="pb-review-card"
                    data-pb-review-card
                    data-rating="{{ block.settings.rating }}"
                    data-review-index="{{ pb_review_index }}"
                    role="button"
                    tabindex="0"
                    aria-label="Open review from {{ block.settings.author | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="pb-review-card__headline">
                      <div class="pb-review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                        {% for i in (1..5) %}
                          <span class="{% if i <= block.settings.rating %}is-on{% endif %}">★</span>
                        {% endfor %}
                      </div>
                      <strong class="pb-review-card__author">{{ block.settings.author | escape }}</strong>
                    </div>

                    <div class="pb-review-card__meta">
                      {% if block.settings.verified %}
                        <span>Verified Purchase</span>
                      {% endif %}
                      {% if block.settings.date != blank %}
                        <time>{{ block.settings.date | escape }}</time>
                      {% endif %}
                    </div>

                    {% if block.settings.title != blank %}
                      <h4 class="pb-review-card__title">{{ block.settings.title | escape }}</h4>
                    {% endif %}

                    {% if block.settings.body != blank %}
                      <div class="pb-review-card__body rte">{{ block.settings.body }}</div>
                    {% endif %}

                    {% if block.settings.image != blank %}
                      <div class="pb-review-card__thumb-wrap">
                        {{
                          block.settings.image
                          | image_url: width: 220
                          | image_tag:
                            loading: 'lazy',
                            widths: '90, 140, 220',
                            class: 'pb-review-card__thumb',
                            alt: block.settings.title
                        }}
                      </div>
                    {% endif %}

                    <template data-pb-review-modal-source>
                      <div class="pb-review-modal-source{% if block.settings.image == blank %} is-no-image{% endif %}">
                        {% if block.settings.image != blank %}
                          <div class="pb-review-modal-source__media">
                            {{
                              block.settings.image
                              | image_url: width: 1400
                              | image_tag:
                                loading: 'lazy',
                                widths: '600, 900, 1200, 1400',
                                class: 'pb-review-modal-source__image',
                                alt: block.settings.title
                            }}
                          </div>
                        {% endif %}

                        <div class="pb-review-modal-source__details">
                          <div class="pb-review-modal-source__headline">
                            <div class="pb-review-card__stars" aria-hidden="true">
                              {% for i in (1..5) %}
                                <span class="{% if i <= block.settings.rating %}is-on{% endif %}">★</span>
                              {% endfor %}
                            </div>
                            <strong>{{ block.settings.author | escape }}</strong>
                          </div>

                          <div class="pb-review-card__meta">
                            {% if block.settings.verified %}
                              <span>Verified Purchase</span>
                            {% endif %}
                            {% if block.settings.date != blank %}
                              <time>{{ block.settings.date | escape }}</time>
                            {% endif %}
                          </div>

                          {% if block.settings.title != blank %}
                            <h4 class="pb-review-modal-source__title">{{ block.settings.title | escape }}</h4>
                          {% endif %}

                          {% if block.settings.body != blank %}
                            <div class="pb-review-modal-source__body rte">{{ block.settings.body }}</div>
                          {% endif %}
                        </div>
                      </div>
                    </template>
                  </article>

                  {% assign pb_review_index = pb_review_index | plus: 1 %}
                {% endif %}
              {% endfor %}
            </div>

            <nav class="pb-review-pagination" data-pb-review-pagination aria-label="Review pages"></nav>
          {% else %}
            {% if request.design_mode %}
              <div class="pb-reviews__preview-note">
                <strong>Review section preview</strong>
                <span>Add real customer feedback using “Manual review” blocks in the Theme Editor.</span>
              </div>
            {% endif %}
          {% endif %}
        </div>

      </div>
    </div>

    <div class="pb-review-modal" data-pb-review-modal hidden>
      <div class="pb-review-modal__backdrop" data-pb-modal-close></div>

      <div class="pb-review-modal__dialog" role="dialog" aria-modal="true" aria-label="Customer review">
        <button type="button" class="pb-review-modal__close" data-pb-modal-close aria-label="Close review">×</button>
        <button type="button" class="pb-review-modal__arrow pb-review-modal__arrow--prev" data-pb-modal-prev aria-label="Previous review">‹</button>
        <button type="button" class="pb-review-modal__arrow pb-review-modal__arrow--next" data-pb-modal-next aria-label="Next review">›</button>

        <div class="pb-review-modal__content" data-pb-review-modal-content></div>
      </div>
    </div>
  </section>
{% endif %}

<style>
  /*
    V2 visual system
    - The page background still comes from the active Shopify color scheme.
    - UI surfaces are intentionally warmer/cleaner so the section feels integrated
      with Plastbat's cream + brown storefront without looking flat.
  */
  #PBProductMain-{{ section.id }} {
    --pb-theme-accent: {% if section.settings.use_theme_colors %}rgb(var(--color-button, 190, 137, 83)){% else %}var(--pb-accent-custom){% endif %};
    --pb-accent: color-mix(in srgb, var(--pb-theme-accent) 72%, #c68a51 28%);
    --pb-cta: color-mix(in srgb, var(--pb-accent) 38%, #5c4436 62%);
    --pb-cta-hover: color-mix(in srgb, var(--pb-cta) 86%, #2f211a 14%);
    --pb-text: color-mix(in srgb, rgb(var(--color-foreground, 83, 65, 54)) 68%, #5a4437 32%);
    --pb-muted: #8f7e72;
    --pb-bg: rgb(var(--color-background, 250, 247, 242));
    --pb-panel: color-mix(in srgb, var(--pb-bg) 48%, #fffdf9 52%);
    --pb-soft-ui: color-mix(in srgb, var(--pb-soft) 46%, #f5eee5 54%);
    --pb-border-ui: color-mix(in srgb, var(--pb-border) 54%, #e3d5c7 46%);
    color: var(--pb-text);
    background: var(--pb-bg);
    font-family: var(--font-body-family, inherit);
    font-size: 16px;
    line-height: 1.5;
  }

  /* Sticky needs visible overflow on the section wrapper in themes that clip sections. */
  .shopify-section:has(#PBProductMain-{{ section.id }}) { overflow: visible !important; }

  #PBProductMain-{{ section.id }} * { box-sizing: border-box; }
  #PBProductMain-{{ section.id }} .is-hidden { display: none !important; }
  #PBProductMain-{{ section.id }} .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  #PBProductMain-{{ section.id }} .pb-product-main__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: min({{ section.settings.padding_bottom }}px, 36px);
  }

  #PBProductMain-{{ section.id }} .pb-product-main__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(420px, .97fr);
    gap: clamp(34px, 4.1vw, 62px);
    align-items: start;
  }

  /* ---------------- GALLERY ---------------- */
  #PBProductMain-{{ section.id }} .pb-gallery {
    min-width: 0;
    align-self: start;
  }

  #PBProductMain-{{ section.id }} .pb-gallery--sticky {
    position: sticky;
    top: {{ section.settings.sticky_top }}px;
    z-index: 2;
    height: max-content;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__stage {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--pb-radius) + 2px);
    background: var(--pb-panel);
    border: 1px solid var(--pb-border-ui);
    aspect-ratio: 1 / 1;
    box-shadow: 0 18px 44px rgba(82, 60, 45, .055);
  }

  #PBProductMain-{{ section.id }} .pb-gallery__panel {
    width: 100%;
    height: 100%;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__panel.is-active { display: block; }

  #PBProductMain-{{ section.id }} .pb-gallery__image,
  #PBProductMain-{{ section.id }} .pb-gallery__video,
  #PBProductMain-{{ section.id }} .pb-gallery__model,
  #PBProductMain-{{ section.id }} .pb-gallery__placeholder {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(76, 57, 45, .14);
    background: rgba(255, 253, 249, .94);
    color: #49362b;
    display: grid;
    place-items: center;
    cursor: pointer;
    z-index: 3;
    box-shadow: 0 7px 22px rgba(76, 57, 45, .10);
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__arrow:hover {
    transform: translateY(-50%) scale(1.045);
    background: #fff;
    box-shadow: 0 10px 28px rgba(76, 57, 45, .14);
  }

  #PBProductMain-{{ section.id }} .pb-gallery__arrow span {
    font-size: 30px;
    line-height: 1;
    margin-top: -2px;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__arrow--prev { left: 15px; }
  #PBProductMain-{{ section.id }} .pb-gallery__arrow--next { right: 15px; }

  #PBProductMain-{{ section.id }} .pb-gallery__counter {
    position: absolute;
    right: 14px;
    bottom: 14px;
    background: rgba(255, 253, 249, .94);
    border: 1px solid rgba(76, 57, 45, .11);
    color: #5d4638;
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    box-shadow: 0 4px 14px rgba(76, 57, 45, .07);
  }

  #PBProductMain-{{ section.id }} .pb-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    margin-top: 13px;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__thumb {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: max(9px, calc(var(--pb-radius) * .55));
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--pb-border-ui);
    background: var(--pb-panel);
    cursor: pointer;
    opacity: .72;
    transition: opacity .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__thumb:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  #PBProductMain-{{ section.id }} .pb-gallery__thumb.is-active {
    opacity: 1;
    border-color: var(--pb-accent);
    box-shadow: inset 0 0 0 1px var(--pb-accent), 0 5px 14px rgba(100, 72, 48, .08);
  }

  #PBProductMain-{{ section.id }} .pb-gallery__thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #PBProductMain-{{ section.id }} .pb-gallery__media-icon {
    position: absolute;
    right: 5px;
    bottom: 5px;
    background: rgba(76, 57, 45, .78);
    color: white;
    width: 21px;
    height: 21px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-size: 8px;
  }

  /* ---------------- PRODUCT INFO ---------------- */
  #PBProductMain-{{ section.id }} .pb-info {
    min-width: 0;
    font-size: 16px;
  }

  #PBProductMain-{{ section.id }} .pb-eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 31px;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--pb-panel);
    border: 1px solid var(--pb-border-ui);
    color: #6f5849;
    font-size: 11.5px;
    line-height: 1;
    letter-spacing: .105em;
    text-transform: uppercase;
    font-weight: 800;
    margin-bottom: 15px;
  }

  #PBProductMain-{{ section.id }} .pb-title {
    margin: 0;
    max-width: 18ch;
    color: #5b4437;
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(36px, 3.05vw, 48px);
    line-height: 1.07;
    letter-spacing: -.035em;
    font-weight: 750;
    text-wrap: balance;
  }

  #PBProductMain-{{ section.id }} .pb-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 17px;
    margin-top: 16px;
    color: var(--pb-muted);
    font-size: 14px;
    line-height: 1.35;
  }

  #PBProductMain-{{ section.id }} .pb-rating {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  #PBProductMain-{{ section.id }} .pb-rating__stars {
    color: #d79531;
    letter-spacing: 1px;
    font-size: 15px;
  }

  #PBProductMain-{{ section.id }} .pb-social-proof { color: var(--pb-muted); }

  #PBProductMain-{{ section.id }} .pb-stock {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 750;
  }

  #PBProductMain-{{ section.id }} .pb-stock i {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 12%, transparent);
  }

  #PBProductMain-{{ section.id }} .pb-stock--in { color: #2e8050; }
  #PBProductMain-{{ section.id }} .pb-stock--out { color: #a4483d; }

  #PBProductMain-{{ section.id }} .pb-price-wrap {
    display: flex;
    align-items: center;
    gap: 11px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  #PBProductMain-{{ section.id }} .pb-price {
    color: #594235;
    font-size: 32px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: -.025em;
  }

  #PBProductMain-{{ section.id }} .pb-compare-price {
    color: #9a8a7f;
    font-size: 17px;
    text-decoration: line-through;
  }

  #PBProductMain-{{ section.id }} .pb-sale-badge {
    display: inline-flex;
    align-items: center;
    padding: 7px 10px;
    background: #fff0e8;
    color: #b4563a;
    border: 1px solid #f4ddd0;
    border-radius: 999px;
    font-size: 11.5px;
    line-height: 1;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: .035em;
  }

  #PBProductMain-{{ section.id }} .pb-short-benefit {
    max-width: 50ch;
    margin: 14px 0 0;
    color: var(--pb-muted);
    font-size: 15.5px;
    line-height: 1.62;
  }

  /* ---------------- FORM / OPTION CARDS ---------------- */
  #PBProductMain-{{ section.id }} .pb-product-form { margin-top: 25px; }

  #PBProductMain-{{ section.id }} .pb-field {
    margin: 0 0 17px;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  #PBProductMain-{{ section.id }} .pb-option-card {
    padding: 17px;
    background: var(--pb-panel);
    border: 1px solid var(--pb-border-ui);
    border-radius: 17px;
    box-shadow: 0 8px 24px rgba(82, 60, 45, .035);
  }

  #PBProductMain-{{ section.id }} .pb-field__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    width: 100%;
    margin-bottom: 12px;
  }

  #PBProductMain-{{ section.id }} .pb-label {
    color: #5e4739;
    font-size: 16px;
    line-height: 1.25;
    font-weight: 820;
  }

  #PBProductMain-{{ section.id }} .pb-selected-value {
    flex: 0 0 auto;
    max-width: 48%;
    padding: 6px 9px;
    border: 1px solid #e8dbce;
    border-radius: 999px;
    background: #faf4ed;
    color: #877568;
    font-size: 13px;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #PBProductMain-{{ section.id }} .pb-selected-value strong {
    color: #5f493b;
    font-weight: 800;
  }

  #PBProductMain-{{ section.id }} .pb-select,
  #PBProductMain-{{ section.id }} .pb-input {
    width: 100%;
    min-height: 57px;
    border-radius: 14px;
    border: 1.25px solid var(--pb-border-ui);
    background: #fffefa;
    color: #4f3c31;
    padding: 14px 16px;
    font-family: var(--font-body-family, inherit);
    font-size: 15.5px;
    line-height: 1.3;
    outline: none;
    transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
  }

  #PBProductMain-{{ section.id }} .pb-input::placeholder {
    color: #aa9b91;
    opacity: 1;
  }

  #PBProductMain-{{ section.id }} .pb-select:focus,
  #PBProductMain-{{ section.id }} .pb-input:focus {
    border-color: var(--pb-accent);
    background: #fff;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--pb-accent) 12%, transparent);
  }

  /* ---------------- COLOR SWATCHES ---------------- */
  #PBProductMain-{{ section.id }} .pb-swatches {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 9px;
  }

  #PBProductMain-{{ section.id }} .pb-swatch-wrap { min-width: 0; }

  #PBProductMain-{{ section.id }} .pb-swatch {
    position: relative;
    min-height: 56px;
    width: 100%;
    border: 1px solid var(--pb-border-ui);
    border-radius: 13px;
    background: #fffefa;
    padding: 9px 28px 9px 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 9px;
    cursor: pointer;
    user-select: none;
    overflow: hidden;
    transition: border-color .16s ease, box-shadow .16s ease, transform .16s ease, background .16s ease;
  }

  #PBProductMain-{{ section.id }} .pb-swatch:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--pb-accent) 60%, var(--pb-border-ui));
    background: #fff;
    box-shadow: 0 5px 16px rgba(91, 68, 55, .055);
  }

  #PBProductMain-{{ section.id }} .pb-swatch__dot {
    width: 27px;
    height: 27px;
    flex: 0 0 27px;
    border-radius: 999px;
    background: var(--swatch);
    border: 1px solid rgba(55, 42, 34, .16);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.22);
  }

  #PBProductMain-{{ section.id }} .pb-swatch__name {
    min-width: 0;
    width: auto;
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    text-align: left;
    color: #675145;
    font-size: 13.5px;
    line-height: 1.18;
    font-weight: 730;
    opacity: 1;
    overflow-wrap: normal;
  }

  #PBProductMain-{{ section.id }} .pb-swatch__check {
    display: none;
    position: absolute;
    top: 50%;
    right: 7px;
    transform: translateY(-50%);
    width: 19px;
    height: 19px;
    border-radius: 999px;
    background: var(--pb-accent);
    color: white;
    font-size: 11px;
    line-height: 19px;
    text-align: center;
    font-weight: 900;
    box-shadow: 0 2px 6px rgba(80, 56, 39, .14);
  }

  #PBProductMain-{{ section.id }} .pb-swatch-input:checked + .pb-swatch {
    border-color: var(--pb-accent);
    background: color-mix(in srgb, var(--pb-accent) 7%, #fffefa);
    box-shadow: inset 0 0 0 1px var(--pb-accent), 0 7px 18px color-mix(in srgb, var(--pb-accent) 10%, transparent);
  }

  #PBProductMain-{{ section.id }} .pb-swatch-input:checked + .pb-swatch .pb-swatch__name {
    color: #513b2f;
    font-weight: 820;
  }

  #PBProductMain-{{ section.id }} .pb-swatch-input:checked + .pb-swatch .pb-swatch__check { display: block; }
  #PBProductMain-{{ section.id }} .pb-swatch-input:focus-visible + .pb-swatch { outline: 2px solid var(--pb-accent); outline-offset: 2px; }

  /* ---------------- PERSONALIZATION ---------------- */
  #PBProductMain-{{ section.id }} .pb-required-badge {
    display: inline-flex;
    padding: 6px 9px;
    border-radius: 999px;
    color: #755b4b;
    font-size: 10.5px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: .065em;
    font-weight: 850;
    background: #f8f1e9;
    border: 1px solid #e7d9cc;
  }

  #PBProductMain-{{ section.id }} .pb-input-shell { position: relative; }
  #PBProductMain-{{ section.id }} .pb-input { padding-right: 69px; }

  #PBProductMain-{{ section.id }} .pb-char-count {
    position: absolute;
    top: 50%;
    right: 16px;
    transform: translateY(-50%);
    color: #9a8b80;
    font-size: 12.5px;
    line-height: 1;
    pointer-events: none;
  }

  #PBProductMain-{{ section.id }} .pb-char-count b {
    color: #755e4f;
    font-weight: 800;
  }

  #PBProductMain-{{ section.id }} .pb-help {
    margin: 9px 1px 0;
    color: #938176;
    font-size: 13px;
    line-height: 1.5;
  }

  #PBProductMain-{{ section.id }} .pb-selection-summary {
    margin: 0 0 17px;
    padding: 13px 14px;
    border-radius: 14px;
    background: #f6efe7;
    border: 1px solid #e4d6c8;
    display: flex;
    align-items: flex-start;
    gap: 11px;
  }

  #PBProductMain-{{ section.id }} .pb-selection-summary__icon {
    width: 27px;
    height: 27px;
    flex: 0 0 27px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: var(--pb-accent);
    color: white;
    font-size: 12px;
    font-weight: 900;
  }

  #PBProductMain-{{ section.id }} .pb-selection-summary strong {
    display: block;
    color: #5f493b;
    font-size: 13.5px;
    line-height: 1.25;
  }

  #PBProductMain-{{ section.id }} .pb-selection-summary p {
    margin: 3px 0 0;
    color: #8b796d;
    font-size: 13px;
    line-height: 1.4;
  }

  /* ---------------- BUY AREA ---------------- */
  #PBProductMain-{{ section.id }} .pb-buy-row {
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr);
    gap: 11px;
  }

  #PBProductMain-{{ section.id }} .pb-qty {
    display: grid;
    grid-template-columns: 38px 1fr 38px;
    min-height: 59px;
    border: 1px solid var(--pb-border-ui);
    border-radius: 15px;
    overflow: hidden;
    background: #fffefa;
  }

  #PBProductMain-{{ section.id }} .pb-qty__button {
    border: 0;
    background: transparent;
    color: #5b4639;
    cursor: pointer;
    font-family: inherit;
    font-size: 21px;
    transition: background .16s ease;
  }

  #PBProductMain-{{ section.id }} .pb-qty__button:hover { background: #f5eee6; }

  #PBProductMain-{{ section.id }} .pb-qty__input {
    width: 100%;
    border: 0;
    background: transparent;
    color: #4e3a30;
    text-align: center;
    font-family: inherit;
    font-size: 16px;
    font-weight: 800;
    appearance: textfield;
    -moz-appearance: textfield;
    outline: none;
  }

  #PBProductMain-{{ section.id }} .pb-qty__input::-webkit-inner-spin-button,
  #PBProductMain-{{ section.id }} .pb-qty__input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

  #PBProductMain-{{ section.id }} .pb-atc {
    min-height: 59px;
    border: 0;
    border-radius: 15px;
    background: var(--pb-cta);
    color: #fffaf5;
