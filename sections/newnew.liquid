<script>
(() => {
  const root=document.getElementById('PBMac-{{ section.id }}'); if(!root||root.dataset.ready==='true')return; root.dataset.ready='true';
  const variants=[{% for variant in product.variants %}{id:{{ variant.id | json }},options:{{ variant.options | json }},available:{{ variant.available | json }},price:{{ variant.price | money | json }},compare:{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %},save:{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times:100 | divided_by:variant.compare_at_price }}{% else %}0{% endif %},mediaId:{% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}];
  const slides=[...root.querySelectorAll('[data-pbmac-media]')],thumbs=[...root.querySelectorAll('[data-pbmac-thumb]')];let active=0;const show=(i)=>{if(!slides.length)return;active=(i+slides.length)%slides.length;slides.forEach((s,x)=>{s.hidden=x!==active;s.classList.toggle('is-active',x===active)});thumbs.forEach((t,x)=>t.classList.toggle('is-active',x===active))};thumbs.forEach(t=>t.addEventListener('click',()=>show(Number(t.dataset.pbmacThumb))));root.querySelector('[data-pbmac-prev]')?.addEventListener('click',()=>show(active-1));root.querySelector('[data-pbmac-next]')?.addEventListener('click',()=>show(active+1));
  const byMedia=(id)=>{if(!id)return;const i=slides.findIndex(s=>String(s.dataset.pbmacMediaId)===String(id));if(i>=0)show(i)};
  const groups=[...root.querySelectorAll('[data-pbmac-option-index]')],variantId=root.querySelector('[data-pbmac-variant-id]'),price=root.querySelector('[data-pbmac-price]'),compare=root.querySelector('[data-pbmac-compare]'),save=root.querySelector('[data-pbmac-save]'),atc=root.querySelector('[data-pbmac-atc]'),atcText=root.querySelector('[data-pbmac-atc-text]'),addText={{ section.settings.add_to_cart_text | json }},soldText={{ section.settings.sold_out_text | json }};
  const selected=()=>groups.map(g=>g.querySelector('[data-pbmac-option-value]:checked')?.value||'');const find=()=>{const w=selected();return variants.find(v=>v.options.length===w.length&&v.options.every((x,i)=>x===w[i]))||null};const render=(v)=>{if(!v){variantId.value='';atc.disabled=true;atcText.textContent='UNAVAILABLE';return}variantId.value=v.id;price.textContent=v.price;compare.textContent=v.compare||'';compare.classList.toggle('is-hidden',!v.compare);save.textContent=`Save ${v.save}%`;save.classList.toggle('is-hidden',!v.save);atc.disabled=!v.available;atcText.textContent=v.available?addText:soldText;byMedia(v.mediaId);try{const u=new URL(location.href);u.searchParams.set('variant',v.id);history.replaceState({},'',u)}catch(e){}};const colorSelectedLabel=root.querySelector('[data-pbmac-color-selected]');
  const syncColorSelected=()=>{const s=root.querySelector('[data-pbmac-color-value]:checked');if(colorSelectedLabel&&s)colorSelectedLabel.textContent=s.value};
  root.querySelectorAll('[data-pbmac-option-value]').forEach(i=>i.addEventListener('change',()=>{render(find());syncColorSelected()}));syncColorSelected();render(find());
  const qty=root.querySelector('[data-pbmac-qty]'),clamp=v=>Math.min(99,Math.max(1,parseInt(v||'1',10)||1));root.querySelector('[data-pbmac-minus]')?.addEventListener('click',()=>qty.value=clamp(Number(qty.value)-1));root.querySelector('[data-pbmac-plus]')?.addEventListener('click',()=>qty.value=clamp(Number(qty.value)+1));
  const sizeModal=root.querySelector('[data-pbmac-sizechart]');root.querySelector('[data-pbmac-sizechart-open]')?.addEventListener('click',()=>{sizeModal.hidden=false;document.body.classList.add('pbmac-modal-open')});root.querySelectorAll('[data-pbmac-sizechart-close]').forEach(x=>x.addEventListener('click',()=>{sizeModal.hidden=true;document.body.classList.remove('pbmac-modal-open')}));
  const preview=root.querySelector('[data-pbmac-preview-modal]'),pers=root.querySelector('[data-pbmac-personalization]');root.querySelector('[data-pbmac-preview-open]')?.addEventListener('click',()=>{if(!preview)return;const opts=selected(),names=groups.map(g=>g.querySelector('legend')?.textContent?.trim().toLowerCase()||''),get=n=>{const i=names.findIndex(x=>x.includes(n));return i>=0?opts[i]:'—'};preview.querySelector('[data-pbmac-preview-style]').textContent=`Style: ${get('style')}`;preview.querySelector('[data-pbmac-preview-color]').textContent=`Color: ${get('color')}`;preview.querySelector('[data-pbmac-preview-size]').textContent=`Size: ${get('size')}`;preview.querySelector('[data-pbmac-preview-text]').textContent=pers?.value.trim()||'No personalization entered';preview.hidden=false;document.body.classList.add('pbmac-modal-open')});root.querySelectorAll('[data-pbmac-preview-close]').forEach(x=>x.addEventListener('click',()=>{preview.hidden=true;document.body.classList.remove('pbmac-modal-open')}));
})();
</script>

{% if section.settings.show_reviews %}
<script>
(() => {
  const section=document.getElementById('pbmac-reviews-{{ section.id }}');
  if(!section||section.dataset.ready==='true')return;
  section.dataset.ready='true';

  const pageSize=10;
  const cards=[...section.querySelectorAll('[data-pbmac-review]')];
  const filters=[...section.querySelectorAll('.pbmac-review-filters button')];
  const pagination=section.querySelector('.pbmac-pagination');
  const modal=section.querySelector('.pbmac-review-modal');
  const content=section.querySelector('.pbmac-review-modal__content');
  const prev=section.querySelector('[data-pbmac-review-prev]');
  const next=section.querySelector('[data-pbmac-review-next]');
  const images=section.querySelector('[data-pbmac-review-images]');
  const imagesPrev=section.querySelector('[data-pbmac-images-prev]');
  const imagesNext=section.querySelector('[data-pbmac-images-next]');
  const imageCards=[...section.querySelectorAll('[data-pbmac-image-review-index]')];

  let rating='all',page=1,modalIndex=-1;

  const filtered=()=>rating==='all'?cards:cards.filter(c=>c.dataset.rating===rating);

  const renderPages=()=>{
    const list=filtered(),pages=Math.max(1,Math.ceil(list.length/pageSize));
    if(page>pages)page=pages;
    pagination.innerHTML='';
    if(list.length<=pageSize){pagination.hidden=true;return}
    pagination.hidden=false;

    const mk=(label,p,active=false,disabled=false)=>{
      const b=document.createElement('button');
      b.type='button';
      b.textContent=label;
      b.dataset.page=p;
      b.disabled=disabled;
      if(active)b.classList.add('is-active');
      return b;
    };

    pagination.appendChild(mk('‹',page-1,false,page===1));
    for(let i=1;i<=pages;i++)pagination.appendChild(mk(String(i),i,i===page));
    pagination.appendChild(mk('›',page+1,false,page===pages));
  };

  const render=(scroll=false)=>{
    const list=filtered(),start=(page-1)*pageSize,current=list.slice(start,start+pageSize);
    cards.forEach(c=>c.hidden=!current.includes(c));
    renderPages();

    if(scroll){
      section.querySelector('.pbmac-topreviews-head')?.scrollIntoView({behavior:'smooth',block:'start'});
    }
  };

  filters.forEach(f=>f.addEventListener('click',()=>{
    if(f.disabled)return;
    filters.forEach(x=>x.classList.remove('is-active'));
    f.classList.add('is-active');
    rating=f.dataset.rating||'all';
    page=1;
    render();
  }));

  pagination?.addEventListener('click',e=>{
    const b=e.target.closest('button[data-page]');
    if(!b||b.disabled)return;
    page=Number(b.dataset.page||1);
    render(true);
  });

  const close=()=>{
    modal.hidden=true;
    document.body.classList.remove('pbmac-modal-open');
    modalIndex=-1;
  };

  const openAt=i=>{
    const list=filtered();
    if(!list.length)return;
    modalIndex=(i+list.length)%list.length;
    const card=list[modalIndex];
    const src=card.querySelector('[data-pbmac-review-modal-source]');
    if(!src)return;
    content.innerHTML='';
    content.appendChild(src.content.cloneNode(true));
    prev.hidden=list.length<=1;
    next.hidden=list.length<=1;
    modal.hidden=false;
    document.body.classList.add('pbmac-modal-open');
  };

  const openCard=card=>{
    const list=filtered();
    const idx=list.indexOf(card);
    if(idx>=0)openAt(idx);
  };

  cards.forEach(c=>{
    c.addEventListener('click',()=>openCard(c));
    c.addEventListener('keydown',e=>{
      if(e.key==='Enter'||e.key===' '){
        e.preventDefault();
        openCard(c);
      }
    });
  });

  imageCards.forEach(imageCard=>{
    imageCard.addEventListener('click',()=>{
      const reviewIndex=Number(imageCard.dataset.pbmacImageReviewIndex||0);
      const card=cards.find(c=>Number(c.dataset.reviewIndex)===reviewIndex);
      if(!card)return;

      if(rating!=='all'){
        rating='all';
        filters.forEach(btn=>btn.classList.toggle('is-active',btn.dataset.rating==='all'));
      }
      openAt(cards.indexOf(card));
    });
  });

  imagesPrev?.addEventListener('click',()=>images?.scrollBy({left:-520,behavior:'smooth'}));
  imagesNext?.addEventListener('click',()=>images?.scrollBy({left:520,behavior:'smooth'}));

  section.querySelectorAll('[data-pbmac-review-close]').forEach(x=>x.addEventListener('click',close));
  prev?.addEventListener('click',()=>openAt(modalIndex-1));
  next?.addEventListener('click',()=>openAt(modalIndex+1));

  document.addEventListener('keydown',e=>{
    if(!modal||modal.hidden)return;
    if(e.key==='Escape')close();
    if(e.key==='ArrowLeft')openAt(modalIndex-1);
    if(e.key==='ArrowRight')openAt(modalIndex+1);
  });

  render();
})();
</script>
{% endif %}

