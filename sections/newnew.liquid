  /* V2 — MACORNER-LIKE COLOR SWATCHES */
  .pbmac-option__selected{
    margin-left:5px;
    color:#a39a9d;
    font-size:12px;
    font-weight:500;
  }
  .pbmac-colors{
    display:flex!important;
    flex-wrap:wrap!important;
    gap:8px!important;
    align-items:center;
  }
  .pbmac-color{
    width:auto!important;
    cursor:pointer;
  }
  .pbmac-color__outer{
    width:56px;
    height:36px;
    padding:3px;
    display:block;
    border:1px solid #ded7d2;
    border-radius:999px;
    background:#fff;
    transition:border-color .15s ease,box-shadow .15s ease;
  }
  .pbmac-color__swatch{
    width:100%!important;
    height:100%!important;
    margin:0!important;
    display:block;
    border:0!important;
    border-radius:999px!important;
  }
  .pbmac-color input:checked + .pbmac-color__outer{
    border-color:#3e373b;
    box-shadow:0 0 0 1px #3e373b;
  }
  .pbmac-color:hover .pbmac-color__outer{
    border-color:#857b7e;
  }
  .pbmac-color__name{
    display:none!important;
  }

