{% comment %}
  PLASTBAT — Macorner-style Shirt Product Page
  File: sections/plastbat-macorner-shirt-product.liquid
  Native Shopify options: Style / Color / Size.
  Includes size chart, personalization preview, shipping card, accordions,
  and manual product reviews with filters, 10-per-page pagination, and modal.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'pbmac-form-' | append: section.id
  assign rating_object = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  if current_variant.compare_at_price > current_variant.price
    assign initial_save = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  else
    assign initial_save = 0
  endif
%}

<section id="PBMac-{{ section.id }}" class="pbmac color-{{ section.settings.color_scheme }}">
  <div class="page-width pbmac__wrap">
    <div class="pbmac__grid">
      <div class="pbmac-gallery{% if section.settings.sticky_gallery %} pbmac-gallery--sticky{% endif %}">
        <div class="pbmac-gallery__main">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <div class="pbmac-gallery__slide{% if forloop.first %} is-active{% endif %}" data-pbmac-media="{{ forloop.index0 }}" data-pbmac-media-id="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>
                {% case media.media_type %}
                  {% when 'image' %}
                    {{ media.preview_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '480,720,960,1200,1600', sizes: '(min-width: 990px) 52vw, 100vw', class: 'pbmac-gallery__image', alt: media.alt | default: product.title }}
                  {% when 'video' %}
                    {{ media | video_tag: controls: true, image_size: '1200x', class: 'pbmac-gallery__video' }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag: class: 'pbmac-gallery__video' }}
                  {% when 'model' %}
                    {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, class: 'pbmac-gallery__video' }}
                  {% else %}
                    {{ media.preview_image | image_url: width: 1600 | image_tag: class: 'pbmac-gallery__image', alt: media.alt | default: product.title }}
                {% endcase %}
              </div>
            {% endfor %}
            {% if product.media.size > 1 %}
              <button type="button" class="pbmac-gallery__arrow pbmac-gallery__arrow--prev" data-pbmac-prev>‹</button>
              <button type="button" class="pbmac-gallery__arrow pbmac-gallery__arrow--next" data-pbmac-next>›</button>
            {% endif %}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'pbmac-gallery__placeholder' }}
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="pbmac-gallery__thumbs">
            {% for media in product.media %}
              <button type="button" class="pbmac-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-pbmac-thumb="{{ forloop.index0 }}">
                {{ media.preview_image | image_url: width: 220 | image_tag: loading: 'lazy', class: 'pbmac-gallery__thumb-image', alt: media.alt | default: product.title }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="pbmac-info">
        <h1 class="pbmac-title">{{ product.title }}</h1>

        {% if rating_object != blank %}
          <div class="pbmac-meta">
            <a href="#pbmac-reviews-{{ section.id }}" class="pbmac-rating"><span>★★★★★</span><b>{{ rating_object.rating | round: 1 }}</b>{% if rating_count != blank %}<em>({{ rating_count }})</em>{% endif %}</a>
          </div>
        {% endif %}

        <div class="pbmac-price-row" aria-live="polite">
          <span class="pbmac-price" data-pbmac-price>{{ current_variant.price | money }}</span>
          <span class="pbmac-compare{% unless current_variant.compare_at_price > current_variant.price %} is-hidden{% endunless %}" data-pbmac-compare>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}</span>
          <span class="pbmac-save{% if initial_save == 0 %} is-hidden{% endif %}" data-pbmac-save>Save {{ initial_save }}%</span>
        </div>



        {% form 'product', product, id: product_form_id, class: 'pbmac-form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-pbmac-variant-id>

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {% assign option_name_down = option.name | downcase %}
              {% assign option_type = 'pill' %}
              {% if option_name_down contains 'color' or option_name_down contains 'colour' %}{% assign option_type = 'color' %}{% endif %}

              <fieldset class="pbmac-option" data-pbmac-option-index="{{ forloop.index0 }}">
                <div class="pbmac-option__head">
                  <legend>
                    {{ option.name }}
                    {% if option_type == 'color' %}
                      <span class="pbmac-option__selected" data-pbmac-color-selected>{{ option.selected_value }}</span>
                    {% endif %}
                  </legend>
                  {% if option_name_down contains 'size' and section.settings.show_size_chart %}
                    <button type="button" class="pbmac-sizechart-link" data-pbmac-sizechart-open>Size Chart</button>
                  {% endif %}
                </div>

                {% if option_type == 'color' %}
                  <div class="pbmac-colors">
                    {% for option_value in option.values %}
                      {% assign value_name = option_value.name %}
                      <label
                        class="pbmac-color{% unless option_value.available %} is-unavailable{% endunless %}"
                        title="{{ value_name | escape }}"
                        aria-label="{{ value_name | escape }}"
                      >
                        <input
                          type="radio"
                          name="pbmac-opt-{{ section.id }}-{{ option.position }}"
                          value="{{ value_name | escape }}"
                          data-pbmac-option-value
                          data-pbmac-color-value
                          {% if option_value.selected %}checked{% endif %}
                        >
                        <span class="pbmac-color__outer">
                          <span
                            class="pbmac-color__swatch pbmac-color--{{ value_name | handleize }}"
                            {% if option_value.swatch.color != blank %}style="background:{{ option_value.swatch.color }}"{% endif %}
                          ></span>
                        </span>
                      </label>
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="pbmac-pills">
                    {% for option_value in option.values %}
                      <label class="pbmac-pill{% unless option_value.available %} is-unavailable{% endunless %}"><input type="radio" name="pbmac-opt-{{ section.id }}-{{ option.position }}" value="{{ option_value.name | escape }}" data-pbmac-option-value {% if option_value.selected %}checked{% endif %}><span>{{ option_value.name }}</span></label>
                    {% endfor %}
                  </div>
                {% endif %}
              </fieldset>
            {% endfor %}
          {% endunless %}

          {% if section.settings.show_personalization %}
            <div class="pbmac-personalization">
              <div class="pbmac-personalization__head"><span>✎</span><strong>{{ section.settings.personalization_heading | escape }}</strong></div>
              <input type="text" class="pbmac-input" name="properties[Personalization]" maxlength="{{ section.settings.personalization_max }}" placeholder="{{ section.settings.personalization_placeholder | escape }}" data-pbmac-personalization {% if section.settings.personalization_required %}required{% endif %}>
            </div>
          {% endif %}

          <div class="pbmac-buy-row">
            <div class="pbmac-qty"><button type="button" data-pbmac-minus>−</button><input type="number" name="quantity" value="1" min="1" max="99" data-pbmac-qty><button type="button" data-pbmac-plus>+</button></div>
            {% if section.settings.show_preview_button %}<button type="button" class="pbmac-preview" data-pbmac-preview-open>👁 {{ section.settings.preview_button_text | escape }}</button>{% endif %}
          </div>

          <button type="submit" name="add" class="pbmac-atc" data-pbmac-atc {% unless current_variant.available %}disabled{% endunless %}><span data-pbmac-atc-text>{% if current_variant.available %}{{ section.settings.add_to_cart_text | escape }}{% else %}{{ section.settings.sold_out_text | escape }}{% endif %}</span></button>
        {% endform %}

        <div class="pbmac-trust"><p>✓ {{ section.settings.trust_1 | escape }}</p><p>✓ {{ section.settings.trust_2 | escape }}</p></div>

        <div class="pbmac-accordions">
          <details class="pbmac-accordion" {% if section.settings.open_description %}open{% endif %}><summary><span>▤</span>{{ section.settings.description_heading | escape }}<b>⌄</b></summary><div class="pbmac-accordion__content rte">{% if section.settings.description_body != blank %}{{ section.settings.description_body }}{% else %}{{ product.description }}{% endif %}</div></details>
          <details class="pbmac-accordion"><summary><span>🚚</span>{{ section.settings.shipping_heading | escape }}<b>⌄</b></summary><div class="pbmac-accordion__content rte">{{ section.settings.shipping_text }}</div></details>
          <details class="pbmac-accordion"><summary><span>ⓘ</span>{{ section.settings.personalization_info_heading | escape }}<b>⌄</b></summary><div class="pbmac-accordion__content rte">{{ section.settings.personalization_info }}</div></details>
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.show_size_chart %}
    <div class="pbmac-modal" data-pbmac-sizechart hidden><div class="pbmac-modal__backdrop" data-pbmac-sizechart-close></div><div class="pbmac-modal__dialog pbmac-sizechart"><button type="button" class="pbmac-modal__close" data-pbmac-sizechart-close>×</button><h3>Size Chart</h3><p>There might be ±1.5 inches difference due to manual measurement and production processes.</p><div class="pbmac-sizechart__table-wrap"><h4>Classic Tee</h4><table><thead><tr><th>Size</th><th>Chest (Front Only)</th><th>Body Length</th></tr></thead><tbody><tr><td>S</td><td>18</td><td>28</td></tr><tr><td>M</td><td>20</td><td>29</td></tr><tr><td>L</td><td>22</td><td>30</td></tr><tr><td>XL</td><td>24</td><td>31</td></tr><tr><td>2XL</td><td>26</td><td>32</td></tr><tr><td>3XL</td><td>28</td><td>33</td></tr><tr><td>4XL</td><td>30</td><td>34</td></tr><tr><td>5XL</td><td>32</td><td>35</td></tr></tbody></table></div></div></div>
  {% endif %}

  {% if section.settings.show_preview_button %}
    <div class="pbmac-modal" data-pbmac-preview-modal hidden><div class="pbmac-modal__backdrop" data-pbmac-preview-close></div><div class="pbmac-modal__dialog pbmac-preview-modal"><button type="button" class="pbmac-modal__close" data-pbmac-preview-close>×</button><span class="pbmac-preview-modal__eyebrow">Preview Your Personalization</span><h3>{{ product.title }}</h3><div class="pbmac-preview-card"><strong data-pbmac-preview-style>—</strong><span data-pbmac-preview-color>—</span><span data-pbmac-preview-size>—</span><em data-pbmac-preview-text>No personalization entered</em></div></div></div>
  {% endif %}
</section>

{% if section.settings.show_reviews %}
<section id="pbmac-reviews-{{ section.id }}" class="pbmac-reviews" data-pbmac-reviews>
  {% liquid
    assign pbmac_review_count = 0
    assign pbmac_rating_total = 0
    assign pbmac_count_5 = 0
    assign pbmac_count_4 = 0
    assign pbmac_count_3 = 0
    assign pbmac_count_2 = 0
    assign pbmac_count_1 = 0
    assign pbmac_image_review_count = 0

    for block in section.blocks
      if block.type == 'manual_review'
        assign pbmac_review_count = pbmac_review_count | plus: 1
        assign pbmac_rating_total = pbmac_rating_total | plus: block.settings.rating

        if block.settings.image != blank
          assign pbmac_image_review_count = pbmac_image_review_count | plus: 1
        endif

        case block.settings.rating
          when 5
            assign pbmac_count_5 = pbmac_count_5 | plus: 1
          when 4
            assign pbmac_count_4 = pbmac_count_4 | plus: 1
          when 3
            assign pbmac_count_3 = pbmac_count_3 | plus: 1
          when 2
            assign pbmac_count_2 = pbmac_count_2 | plus: 1
          when 1
            assign pbmac_count_1 = pbmac_count_1 | plus: 1
        endcase
      endif
    endfor

    if pbmac_review_count > 0
      assign pbmac_average = pbmac_rating_total | times: 1.0 | divided_by: pbmac_review_count
    else
      assign pbmac_average = 0
    endif
  %}

  <div class="page-width">
    <div class="pbmac-review-tabs-top">
      <span class="is-active">Product Reviews</span>
    </div>

    <div class="pbmac-reviews-layout">
      <aside class="pbmac-reviews-card">
        <h2>Reviews for this item</h2>

        {% if pbmac_review_count > 0 %}
          <div class="pbmac-reviews-card__score">
            <strong>{{ pbmac_average | round: 1 }}</strong>
            <div>
              <span class="pbmac-reviews-card__stars">★★★★★</span>
              <small>{{ pbmac_review_count }} Review{% if pbmac_review_count != 1 %}s{% endif %}</small>
            </div>
          </div>

          {% assign pbmac_counts = pbmac_count_5 | append: ',' | append: pbmac_count_4 | append: ',' | append: pbmac_count_3 | append: ',' | append: pbmac_count_2 | append: ',' | append: pbmac_count_1 | split: ',' %}
          <div class="pbmac-histogram">
            {% for star in (1..5) reversed %}
              {% assign idx = 5 | minus: star %}
              {% assign count = pbmac_counts[idx] | plus: 0 %}
              {% assign pct = count | times: 100 | divided_by: pbmac_review_count %}
              <div class="pbmac-histogram__row">
                <span>{{ star }} Star</span>
                <div><i style="width:{{ pct }}%"></i></div>
                <b>{{ pct }}%</b>
              </div>
            {% endfor %}
          </div>

          <span class="pbmac-review-static-button">Customer Feedback</span>
        {% else %}
          <p class="pbmac-empty-review">No product reviews yet.</p>
        {% endif %}
      </aside>

      <div class="pbmac-reviews-content">
        {% if pbmac_image_review_count > 0 %}
          <div class="pbmac-review-images-head">
            <h3>Reviews with Images</h3>
            <div class="pbmac-review-images-arrows">
              <button type="button" data-pbmac-images-prev aria-label="Previous images">‹</button>
              <button type="button" data-pbmac-images-next aria-label="Next images">›</button>
            </div>
          </div>

          <div class="pbmac-review-images" data-pbmac-review-images>
            {% assign pbmac_review_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'manual_review' %}
                {% if block.settings.image != blank %}
                  <button
                    type="button"
                    class="pbmac-review-image-card"
                    data-pbmac-image-review-index="{{ pbmac_review_index }}"
                    aria-label="Open review from {{ block.settings.author | escape }}"
                  >
                    {{
                      block.settings.image
                      | image_url: width: 500
                      | image_tag:
                        loading: 'lazy',
                        widths: '180,260,360,500',
                        class: 'pbmac-review-image-card__image',
                        alt: block.settings.title
                    }}
                  </button>
                {% endif %}
                {% assign pbmac_review_index = pbmac_review_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <div class="pbmac-topreviews-head">
          <h3>Top reviews</h3>
        </div>

        {% if pbmac_review_count > 0 %}
          <div class="pbmac-review-filters">
            <button class="is-active" type="button" data-rating="all">All Reviews ({{ pbmac_review_count }})</button>
            <button type="button" data-rating="5" {% if pbmac_count_5 == 0 %}disabled{% endif %}>5 Star ({{ pbmac_count_5 }})</button>
            <button type="button" data-rating="4" {% if pbmac_count_4 == 0 %}disabled{% endif %}>4 Star ({{ pbmac_count_4 }})</button>
            <button type="button" data-rating="3" {% if pbmac_count_3 == 0 %}disabled{% endif %}>3 Star ({{ pbmac_count_3 }})</button>
            <button type="button" data-rating="2" {% if pbmac_count_2 == 0 %}disabled{% endif %}>2 Star ({{ pbmac_count_2 }})</button>
            <button type="button" data-rating="1" {% if pbmac_count_1 == 0 %}disabled{% endif %}>1 Star ({{ pbmac_count_1 }})</button>
          </div>

          <div class="pbmac-review-list">
            {% assign pbmac_review_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'manual_review' %}
                <article
                  class="pbmac-review"
                  data-pbmac-review
                  data-rating="{{ block.settings.rating }}"
                  data-review-index="{{ pbmac_review_index }}"
                  role="button"
                  tabindex="0"
                  {{ block.shopify_attributes }}
                >
                  <div class="pbmac-review__headline">
                    <span class="pbmac-review__stars">
                      {% for i in (1..5) %}
                        <i class="{% if i <= block.settings.rating %}is-on{% endif %}">★</i>
                      {% endfor %}
                    </span>
                    <strong>{{ block.settings.author | escape }}</strong>
                  </div>

                  <div class="pbmac-review__meta">
                    {% if block.settings.verified %}<span>Verified Purchase</span>{% endif %}
                    {% if block.settings.date != blank %}<time>{{ block.settings.date | escape }}</time>{% endif %}
                  </div>

                  {% if block.settings.title != blank %}<h4>{{ block.settings.title | escape }}</h4>{% endif %}
                  {% if block.settings.body != blank %}<div class="pbmac-review__body rte">{{ block.settings.body }}</div>{% endif %}

                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 220
                      | image_tag:
                        loading: 'lazy',
                        widths: '90,140,220',
                        class: 'pbmac-review__thumb',
                        alt: block.settings.title
                    }}
                  {% endif %}

                  <template data-pbmac-review-modal-source>
                    <div class="pbmac-review-modal-source{% if block.settings.image == blank %} is-no-image{% endif %}">
                      {% if block.settings.image != blank %}
                        <div class="pbmac-review-modal-source__media">
                          {{
                            block.settings.image
                            | image_url: width: 1400
                            | image_tag:
                              loading: 'lazy',
                              widths: '600,900,1200,1400',
                              class: 'pbmac-review-modal-source__image',
                              alt: block.settings.title
                          }}
                        </div>
                      {% endif %}

                      <div class="pbmac-review-modal-source__details">
                        <div class="pbmac-review__headline">
                          <span class="pbmac-review__stars">
                            {% for i in (1..5) %}
                              <i class="{% if i <= block.settings.rating %}is-on{% endif %}">★</i>
                            {% endfor %}
                          </span>
                          <strong>{{ block.settings.author | escape }}</strong>
                        </div>

                        <div class="pbmac-review__meta">
                          {% if block.settings.verified %}<span>Verified Purchase</span>{% endif %}
                          {% if block.settings.date != blank %}<time>{{ block.settings.date | escape }}</time>{% endif %}
                        </div>

                        {% if block.settings.title != blank %}<h4>{{ block.settings.title | escape }}</h4>{% endif %}
                        {% if block.settings.body != blank %}<div class="rte">{{ block.settings.body }}</div>{% endif %}
                      </div>
                    </div>
                  </template>
                </article>

                {% assign pbmac_review_index = pbmac_review_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>

          <nav class="pbmac-pagination" aria-label="Review pages"></nav>
        {% elsif request.design_mode %}
          <div class="pbmac-empty-review">Add real customer reviews using “Manual review” blocks.</div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="pbmac-review-modal" hidden>
    <div class="pbmac-review-modal__backdrop" data-pbmac-review-close></div>
    <div class="pbmac-review-modal__dialog" role="dialog" aria-modal="true">
      <button type="button" class="pbmac-review-modal__close" data-pbmac-review-close>×</button>
      <button type="button" class="pbmac-review-modal__arrow pbmac-review-modal__arrow--prev" data-pbmac-review-prev>‹</button>
      <button type="button" class="pbmac-review-modal__arrow pbmac-review-modal__arrow--next" data-pbmac-review-next>›</button>
      <div class="pbmac-review-modal__content"></div>
    </div>
  </div>
</section>
{% endif %}

<style>
  #PBMac-{{ section.id }}{--dark:#2f2b31;--muted:#7f7881;--orange:#f16422;background:rgb(var(--color-background,250,247,242));color:var(--dark);font-family:var(--font-body-family,inherit)}
  #PBMac-{{ section.id }} *{box-sizing:border-box}.is-hidden{display:none!important}.pbmac__wrap{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}.pbmac__grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(420px,.92fr);gap:clamp(34px,4vw,60px);align-items:start}
  .pbmac-gallery{min-width:0;align-self:start}.pbmac-gallery--sticky{position:sticky;top:{{ section.settings.sticky_top }}px}.pbmac-gallery__main{position:relative;aspect-ratio:1/1;overflow:hidden;border:1px solid #ded8d3;border-radius:10px;background:#f6f6f6}.pbmac-gallery__slide{width:100%;height:100%}.pbmac-gallery__image,.pbmac-gallery__video,.pbmac-gallery__placeholder{width:100%;height:100%;display:block;object-fit:contain}.pbmac-gallery__arrow{position:absolute;top:50%;width:48px;height:48px;transform:translateY(-50%);border:1px solid #ded7d1;border-radius:999px;background:rgba(255,255,255,.96);color:#342f34;display:grid;place-items:center;font-size:32px;cursor:pointer;box-shadow:0 5px 18px rgba(0,0,0,.08)}.pbmac-gallery__arrow--prev{left:16px}.pbmac-gallery__arrow--next{right:16px}.pbmac-gallery__thumbs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-top:10px}.pbmac-gallery__thumb{padding:0;aspect-ratio:1/1;overflow:hidden;border:1px solid #e0dad5;border-radius:8px;background:#fff;opacity:.7;cursor:pointer}.pbmac-gallery__thumb.is-active{opacity:1;border:2px solid #3f3532}.pbmac-gallery__thumb-image{width:100%;height:100%;object-fit:cover;display:block}
  .pbmac-title{margin:0;color:#262329;font-family:var(--font-heading-family,inherit);font-size:clamp(30px,2.6vw,42px);line-height:1.08;font-weight:760;letter-spacing:-.025em}.pbmac-meta{margin-top:11px}.pbmac-rating{display:inline-flex;align-items:center;gap:6px;color:#4e474b;text-decoration:none;font-size:13px}.pbmac-rating span{color:var(--orange);letter-spacing:1px}.pbmac-rating em{font-style:normal;color:#90878b}.pbmac-price-row{display:flex;align-items:center;flex-wrap:wrap;gap:9px;margin-top:15px}.pbmac-price{font-size:29px;font-weight:780}.pbmac-compare{color:#aaa1a3;text-decoration:line-through;font-size:17px}.pbmac-save{color:#e7632c;font-weight:750;font-size:13px}
  .pbmac-bundle{margin-top:18px;padding:14px 15px;border:1px solid #e3ddd8;border-radius:10px;background:#fff}.pbmac-bundle>strong{display:block;font-size:14px;margin-bottom:9px}.pbmac-bundle>div{display:flex;flex-wrap:wrap;gap:8px}.pbmac-bundle span{padding:7px 9px;border-radius:6px;background:#fff5ef;color:#b55329;font-size:12px;font-weight:700}.pbmac-bundle small{display:block;margin-top:8px;color:#948b8f;font-size:11.5px}
