{%- comment -%}
  Floating contact bubble (email), rendered globally from layout/theme.liquid.
  On product pages the stack is lifted on mobile so it never covers the sticky add-to-cart bar.
{%- endcomment -%}

{%- liquid
  assign support_email = 'support@plastbat.com'

  assign lift_on_mobile = false
  if request.page_type == 'product'
    assign lift_on_mobile = true
  endif
-%}

<div class="pb-contact-bubbles{% if lift_on_mobile %} pb-contact-bubbles--lifted{% endif %}">
  <a
    class="pb-contact-bubble pb-contact-bubble--email"
    href="mailto:{{ support_email }}"
    aria-label="Email us at {{ support_email }}"
  >
    <span class="pb-contact-bubble__label" aria-hidden="true">{{ support_email }}</span>
    <svg class="pb-contact-bubble__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <rect x="2.75" y="4.75" width="18.5" height="14.5" rx="3" stroke="currentColor" stroke-width="1.8"/>
      <path d="m4 8 6.9 4.6c.67.45 1.53.45 2.2 0L20 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </a>
</div>
