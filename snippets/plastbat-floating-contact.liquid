{%- comment -%}
  Floating contact bubbles (Messenger + email), rendered globally from layout/theme.liquid.
  On product pages the stack is lifted on mobile so it never covers the sticky add-to-cart bar.
{%- endcomment -%}

{%- liquid
  assign messenger_url = 'https://m.me/61591757378102'
  assign support_email = 'support@plastbat.com'

  assign lift_on_mobile = false
  if request.page_type == 'product'
    assign lift_on_mobile = true
  endif
-%}

<div class="pb-contact-bubbles{% if lift_on_mobile %} pb-contact-bubbles--lifted{% endif %}">
  <a
    class="pb-contact-bubble pb-contact-bubble--messenger"
    href="{{ messenger_url }}"
    target="_blank"
    rel="noopener"
    aria-label="Chat with us on Facebook Messenger"
  >
    <span class="pb-contact-bubble__label" aria-hidden="true">Chat on Messenger</span>
    <svg class="pb-contact-bubble__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12 2C6.24 2 2 6.22 2 11.92c0 2.98 1.23 5.55 3.23 7.33.17.15.27.36.28.58l.05 1.83c.02.58.62.96 1.15.72l2.04-.9c.17-.07.36-.09.54-.04 1.01.28 2.09.43 3.21.43 5.76 0 10-4.22 10-9.92S17.76 2 12 2Zm6 7.63-2.94 4.66c-.47.74-1.47.93-2.18.4l-2.34-1.75a.6.6 0 0 0-.72 0l-3.16 2.4c-.42.32-.97-.18-.69-.63l2.94-4.66c.47-.74 1.47-.93 2.18-.4l2.34 1.75c.21.16.51.16.72 0l3.16-2.39c.42-.32.97.18.69.62Z"/>
    </svg>
  </a>

  <a
    class="pb-contact-bubble pb-contact-bubble--email"
    href="mailto:{{ support_email }}"
    aria-label="Email us at {{ support_email }}"
  >
    <span class="pb-contact-bubble__label" aria-hidden="true">{{ support_email }}</span>
    <svg class="pb-contact-bubble__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <rect x="2.75" y="4.75" width="18.5" height="14.5" rx="3" stroke="currentColor" stroke-width="1.8"/>
      <path d="m4 8 6.9 4.6c.67.45 1.53.45 2.2 0L20 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </a>
</div>
